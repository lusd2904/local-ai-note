nabled\":true,\"bingEnabled\":false,\"grokEnabled\":false,\"searchCompletionSource\":2,\"maxChars\":70},\"suggestion_bing_worker\":true,\"enable_multiturn_suggestions\":false,\"log_suggestion_usage_data\":false,\"use_new_og_image_method\":true,\"show_grok_home_promotion_dialog\":false,\"grok_home_promotion_banner_id\":{\"id\":\"2025-11-17\",\"try_now_model\":\"grok-4-1\",\"image\":\"https://x.ai/images/news/grok-4-1.webp\",\"full_announcement_url\":\"https://x.ai/news/grok-4-1\"},\"enable_grok_4_1_upsells\":true,\"show_quick_answer_thumbs_up\":true,\"suggestion_qa_msg_template\":\"\",\"enable_imagine_video_length\":true,\"quick_answer_rating\":\"\",\"enable_stream_close_error_throw\":true,\"enable_notifications\":true,\"notifications_fetch_interval_ms\":0,\"enable_temp_always_request_share_link\":true,\"enable_imagine_delete_button\":true,\"enable_imagine_image_edit\":true,\"enable_highlights_dismiss_button\":true,\"redirect_request_convo_fetch_interval_ms\":5000,\"enable_enterprise_teams_connectors_and_collections\":true,\"show_auto_share_settings\":true,\"enable_upgrade_button_in_chat_new_top_nav\":false,\"enable_upgrade_button_in_sidebar\":false,\"supergrok_paywall_annual_pricing_monthly_equivalent_enabled\":false,\"supergrok_paywall_annual_selected_default_enabled\":false,\"supergrok_paywall_interval_selector_at_top_enabled\":false,\"supergrok_paywall_hide_free_plan_card_enabled\":false,\"enable_upgrade_button_in_imagine_page\":true,\"enable_global_image_editor\":true,\"inline-rate-limit-banner\":true,\"show_memory_tool_usage\":true,\"disable_imagine_rabbit_hole\":false,\"enable_katex_scroll_feathering\":false,\"show_memory_tool_card_only_in_arena\":true,\"no_imagine_banner\":false,\"enable_code_parallel_agents\":false,\"enable_imagine_more_button\":true,\"show_streaming_response_pivot_button\":true,\"enable_imagine_query_bar_v2\":true,\"show_model_submenu\":false,\"enable_memory_v2_management\":false,\"show_model_hash_debug\":false,\"imagine_enable_child_post_ids\":true,\"enable_memory_editing\":true,\"enable_share_to_x_button\":true,\"enable_drawing_background_image\":true,\"hide_map_during_tiles_load\":false,\"enable_query_bar_v2\":false,\"forward_headers_imagine_og_route\":false,\"use_open_in_app_banner\":true,\"extra-config\":{},\"show_connect_x_upsell\":true,\"places_map_load_behavior\":\"FLIP\",\"enable_enterprise_sources_selector_in_query_bar\":true,\"enable_chat_backdrop_gradient\":false,\"enable_upload_button_imagine_page\":true,\"force_allow_memory_settings\":false,\"highlights-enable-public-linking\":true,\"model_fav_enabled\":false,\"enable_tiptap_paste_newlines\":true,\"web_voice_rich_format_transcript_enabled\":false,\"enable_rich_format\":true,\"enable_enterprise_mention_menu_in_query_bar_editor\":false,\"dev_models\":false,\"show_code_remote_coming_soon\":false,\"enable_imagine_more_in_chat\":false,\"enable_grokcast_share_web\":false,\"enable_code_webpage_preview\":false,\"voice_chat_view_recording_player\":false,\"upgrade_button_in_new_chat_top_position\":\"none\",\"route-web-mixpanel-logging-to-data-gateway\":true,\"cloud-console-new-people-page\":false,\"enable_imagine_video_cancel_button\":true,\"enable_imagine_video_auto_generation_preference\":true,\"enable_browser_geo_location\":false,\"enable_dictation\":true,\"post_purchase_success_dialog\":true,\"enable_gmail_search_tool\":true,\"enable_upsell_plans_v3\":true,\"enable_imagine_perf_monitor\":false,\"enable_turn_edits_summary\":false,\"show_web_720p_nux\":false,\"enable_calendar_search_tool\":true,\"GROK_CODE_ENABLE_START_WORKTREE_SESSION\":true,\"enable_fetch_offer_data\":true,\"enable_imagine_mie\":true,\"enable_grok_web_attach_generated_images\":false,\"table_card\":true,\"enable_code_arena_mode\":false,\"enable_code_branch_switch\":false,\"sharepoint-connector-frontend-grok-web\":false,\"enable_imagine_video_flicker_fix\":true,\"voice_enable_attachments_in_conversations\":true,\"vibe_model_id\":\"OFF\",\"disable_voice_mode\":true,\"enable_google_drive_integration\":true,\"enable_onedrive_integration\":true,\"grok_web_consumer_user_mcp\":true,\"enable_x_integration\":true,\"enable_code_editor\":true,\"enable_query_bar_sources_selector\":true,\"enable_imagine_toolbar\":true,\"disable_image_gen\":false,\"enable_imagine_mentions\":true,\"use_new_modes_api\":true,\"disable_changelog\":false,\"pay_upfront_new_chat\":\"variation1\",\"pay_upfront_imagine_rate_limit\":\"variation2\",\"pay_upfront_chat_rate_limit\":\"variation1\",\"pay_upfront_model_select\":\"\",\"pay_upfront_imagine_page\":\"\",\"enable_imagine_reference_to_video\":true,\"enable_websearch\":true,\"enable_hide_thinking_trace\":true,\"dev_models_write\":false,\"imagine_lightbox_feedback\":{\"enabled\":true,\"videoTriggerRate\":0.025,\"imageTriggerRate\":0.025,\"videoPlaythroughsRequired\":1,\"imageEditDelayMs\":7000,\"reasonThreshold\":3},\"use_imagine_open_in_app_dialog\":true,\"grok_web_banner_text\":\"\",\"subscriptions_cancel_flow_enabled\":true,\"enable_code_mcp_connectors\":false,\"enable_quick_imagine_redo_shortcut\":true,\"enable_playground\":false,\"enable_imagine_folders\":true,\"enable_agent_customizations\":false,\"hide_default_template_presets\":false,\"hide_default_example_projects\":false,\"enable_imagine_extend_timeline\":true,\"enable_grok_420_toggle_in_model_select\":false,\"enable_paypal_checkout_route\":true,\"enable_imagine_floating_prompt\":false,\"enable_imagine_query_bar_animation\":false,\"ZW5hYmxlX2RpcmVjdG9y\":true,\"enable_dp\":false,\"grok_web_business_user_mcp\":true,\"vibe_config\":{},\"enable_imagine_shared_folders\":false,\"web_grok_actionable_redirect\":true,\"enable_imagine_web_infinite_feed\":\"control\",\"grok_web_mcp_enabled_advanced_selector\":true,\"grok_web_mcp_connectors_show_cta\":true,\"enable_imagine_r2v\":true,\"enable_imagine_home_v2\":{\"maximized_home\":true,\"enable_templates\":true,\"show_recent_urls\":true},\"enable_new_citation_link\":false,\"grok_web_enterprise_nux_info\":null,\"imagine_templates_web\":{\"templates\":[{\"title\":\"Funky Dance\",\"videoPrompt\":\"Animate this subject dancing energetically and confidently for exactly 6 seconds in smooth 30fps, funky disco choreography matching this precise high-energy sequence: 0.0–1.0s: Begin in the starting pose from the reference image, then burst into motion with dramatic arm point like Saturday Night Fever while raising one leg high bent at the knee, hips swaying with attitude. 1.0–2.2s: Transition to fast rhythmic hip shakes side-to-side, arms performing big expressive circular disco swings, head bobbing in sync 2.2–3.5s: Execute a smooth 360° clockwise spin, arms raising in a V-shape then crossing body, ending with a powerful forward hip thrust and sharp pose accent. 3.5–4.8s: Fast dynamic footwork with deep knee bends and side-to-side steps, arms alternating stylish pumps and rolls, full body showing playful confident grin 4.8–6.0s: Build to climax with double arms raised overhead while doing a final big hip shake, then drop into a confident wide stance and hold a strong proud victory pose with head tilted back for the last 0.3–0.5 seconds. Make sure the character remains fully dressed with proper pants throughout the entire video.\",\"postID\":\"7c1a550f-6a03-4d6b-8eea-83bbd5911dc9\",\"description\":\"Makes you dance funky disco with spins, hip shakes, and victory pose.\"},{\"title\":\"Chibi\",\"imagePrompt\":\"Transform the subjects into a cute anime chibi characters rendered as a clean 3D model, while preserving the subject’s original race, ethnicity, skin tone, and recognizable facial likeness, including hairstyle, hair color, and clothing colors. If the input image does not clearly show clothing, generate appropriate casual clothing that naturally fits the character so the subject is always clothed. The character must remain clearly the same person with the same skin tone and ethnic appearance as the original input, translated into a chibi form. The character should have classic chibi proportions: a very large head, small torso, simplified cute facial features, and large expressive anime-style eyes. Translate the subject’s facial features into a chibi style while keeping their recognizable likeness. Frame the character from the torso up, with the camera slightly closer and cropped in, so the upper body and head fill most of the frame. The character should be looking directly into the camera, with an energetic and expressive anime-style pose. Use a slightly dynamic camera angle, such as a subtle tilt or off-axis perspective, similar to modern anime promotional artwork. The camera can be slightly lower than the character’s face, creating a playful upward angle that makes the character feel lively and engaging. Render the character as a high-quality glossy 3D anime-style model, similar to a polished Blender render or premium collectible figure. The materials should be smooth, reflective, and toy-like, with strong highlights, soft reflections, and shiny surfaces. The overall look should clearly resemble a 3D rendered character, not a flat 2D illustration. Use bright anime-style shading with vibrant but polished colors, giving the character a premium anime aesthetic. Place the character in front of a colorful gradient background. Behind the character, include a small number of large, translucent decorative shapes such as bubbles, stars, or rounded forms. These shapes should appear semi-transparent, glossy, and subtle, similar to clear acrylic or glass, softly floating in the background without drawing attention away from the character. The background elements should remain light, minimal, and softly visible, acting as stylish accents rather than prominent objects. The final image should look like a dynamic, glossy 3D chibi character render, with polished materials, vibrant colors, and a premium collectible aesthetic, while clearly maintaining the subject’s original race, skin tone, and recognizable identity.\",\"templateType\":\"I2I\",\"postID\":\"54009e77-72a1-4189-a650-731631a55838\",\"description\":\"Transforms you into an adorable, big-eyed 3D chibi-style cartoon avatar.\"},{\"postID\":\"94d86171-ef2e-40fa-9f4d-45457a4a47b8\",\"title\":\"Add Girlfriend\",\"prompt\":\"add a girlfriend\",\"description\":\"Adds a girlfriend to the scene.\"},{\"title\":\"Comic Book\",\"imagePrompt\":\"Transform the input image into the style of a classic 1960s–1970s American comic book illustration while preserving the subject’s recognizable identity, pose, clothing, and overall scene composition. Reinterpret the subject as if drawn for a vintage superhero comic panel: bold black ink outlines, simplified shapes, dynamic shading, and flat color blocks typical of old comic printing. The face should remain recognizable but slightly stylized with stronger jawline, clearer cheekbones, expressive eyes, and confident comic-book character energy. Clothing and environment should remain based on the original image but translated into comic-style textures and colors. Add subtle halftone printing dots and vintage comic coloring to emulate the look of a classic printed superhero comic page.\",\"templateType\":\"I2I\",\"postID\":\"7bf6566f-30b5-4bcf-bfd1-fb296fac5edb\",\"description\":\"Turns your photo into classic 1960s-1970s comic book style.\"},{\"title\":\"Product Photography\",\"description\":\"Places your product in real-life lifestyle scenes.\",\"imagePrompt\":\"Using the exact product in \u003cIMAGE_0\u003e, place it into a fresh, natural real-world lifestyle scene while keeping it 100% identical in every detail: design, colors, materials, textures, logos, branding and proportions unchanged. The new environment should be an engaging modern context such as a contemporary home, luxury interior, outdoor setting, urban lifestyle or premium everyday space — choose the most flattering one. Perfectly integrate with realistic lighting, shadows and reflections. Creatively control the mood and atmosphere to enhance the brand feel. High-end commercial product photography, photorealistic, maximum detail.\",\"templateType\":\"I2I\",\"imagePreviewURL\":\"https://imagine-public.x.ai/imagine-public/share-images/f67a9ec2-4bc2-400b-b584-fb65236abb5f.jpg\",\"postID\":\"f67a9ec2-4bc2-400b-b584-fb65236abb5f\"},{\"title\":\"Gigachad\",\"imagePrompt\":\"Black and white headshot up close head shot, low angle upward tilt, tight skin no strange creases perfectly taught across subjects face, dramatically pronounced and increased jaw size, update the subject’s facial structure and anatomy so they have roman carving level jawline, overly exaggerated pronounced jawline, and accentuated cheekbones, overly hyper masculine facial structure, exaggerated facial structure, dramatic shadows, increased jaw size and width. Young, good smooth skin, muscular updated build. Dark background. Exaggerated facial features and muscular build. Retain clothing and hair style. Subject should look have superhero level anatomy. Photo is low angle at a slight angle, up close to the subject face highlighting the subjects dramatically strong jawline. The subject has incredible smooth tight skin, dramatically intense jaw structure, almost animated looking in it's composition. Skin is updated to be flawless and tight against facial bone features.\",\"templateType\":\"I2I\",\"postID\":\"234653bd-8e5b-4f24-99da-f2c629d8ec51\",\"description\":\"Turns you into a super muscular Gigachad.\"},{\"postID\":\"5a1ee5d0-6a82-4a02-b5ec-e1558cc69981\",\"title\":\"Soda Pop\",\"prompt\":\"The subjects as if drinking with their right hand in a call me / shaka / hang ten hand gesture :call_me_hand: (thumb and pinky extended, other fingers curled, pinky toward the mouth like holding and sipping from a soda can), left hand on hip, in a dance-like way doing a tilting/pouring motion into their mouth with a slight head tilt back, and then does a dynamic vibey k-pop style dance. Camera motion adjusts to capture the full frame of the subject. Super active choreographed k-pop and hiphop style dance moves, camera lock, final cool landing position at the end.\",\"description\":\"Sips soda with a cool hand gesture then dances K-pop style.\"},{\"title\":\"Haze Portrait\",\"imagePrompt\":\"Transform the input photo into a cinematic chromatic haze portrait of the same person, preserving their identity, facial structure, skin tone, hairstyle, expression, and overall styling. Recompose the image as a subtle three-quarter side portrait, with the subject turned slightly away from camera and gazing off-frame. Create a soft double-exposure-like chromatic offset around the face and hair, with gentle red/orange glow on one side and cool cyan/blue glow on the other, producing a dreamy optical ghosting effect rather than a glitch effect. Keep the portrait clean, minimal, and editorial. Use soft diffused studio lighting, shallow depth of field, smooth skin rendering, and a calm high-end fashion photography feel. The image should feel atmospheric and futuristic, with luminous color bleed, soft motion haze, feathered edges, and a polished fine-art beauty portrait look. Background should be plain, bright, and unobtrusive, fading into soft white or cream. Preserve realism in the face while adding the chromatic haze treatment around contours and profile edges. No harsh glitch artifacts, no heavy distortion, no text, no busy background, no extra objects.\",\"templateType\":\"I2I\",\"postID\":\"9ab62ecc-a117-4ff1-8c0d-8890e54c25ff\",\"description\":\"Creates a dreamy glowing haze portrait.\"},{\"title\":\"Showcase\",\"imagePrompt\":\"Using the uploaded product image as reference, create a crisp photoreal product hero shot on a smooth, minimal gradient backdrop (subtle tonal shift, not colorful rainbow). Soft studio lighting with one large diffused key light and gentle fill; clean shadow under the product; faint highlight edge that matches its material. No props, no clutter. Product proportions and branding must remain exact and readable. Shot like high-end ecommerce photography, 70mm lens look, tack-sharp details, neutral color accuracy. Provide ample negative space for storefront layout.\",\"videoPrompt\":\"Very subtle cinematic pan to the right, keeping the object centered in the frame throughout. Steady, smooth, aesthetic.\",\"templateType\":\"I2I2V\",\"videoPreviewURL\":\"https://imagine-public.x.ai/imagine-public/share-videos/7b097052-8cfe-4b0f-8a33-c2a71e1aed25.mp4\",\"postID\":\"7b097052-8cfe-4b0f-8a33-c2a71e1aed25\",\"description\":\"Creates a clean studio product photo with soft lighting and a smooth pan.\"},{\"title\":\"Roman Empire\",\"imagePrompt\":\"Transform the person in the input image into a cinematic ancient Roman epic scene, as if they are a central character in a large-scale historical blockbuster film.Preserve the subject’s recognizable identity from the original image — including their facial structure, hairstyle, skin tone, age, and overall likeness — while adapting their appearance to fit the world of ancient Rome.Frame the scene as a dramatic cinematic composition, showing the subject in a three-quarter body view, allowing the armor, stance, and surrounding Roman environment to be clearly visible.Style the subject as a Roman warrior, general, or noble figure, wearing ornate epic Roman armor that feels sculpted and organic, as if it was forged specifically for them.The armor should appear cinematic, mythic, and heroic, inspired by ancient Roman design but elevated to the scale of a blockbuster historical epic.Typical armor characteristics may include: • sculpted metal surfaces that follow the contours of the body • engraved patterns inspired by Roman mythology • layered metal and leather elements integrated into the design • intricate ornamental details and symbolic engravings • subtle battle-worn textures and aged materials Do not include any cape or cloak. The armor should stand on its own without a red cape or flowing fabric.The armor should feel slightly organic and artistic rather than rigid, with elegant curves, sculptural shapes, and intricate detailing that make it appear legendary and powerful.Hair and grooming should remain recognizable from the original image while being adapted to fit the historical setting.The subject should have a serious, focused, and inspirational expression, conveying strength, resolve, and leadership. Their face should appear calm, determined, and heroic, as if they are preparing for battle or inspiring those around them.Place the subject in a grand Roman environment, such as: • a massive Roman battlefield at dawn• the steps of an ancient Roman temple• the Roman Colosseum in the background • a dramatic imperial cityscape with marble columns and statues. The environment should feel large, epic, and cinematic, with atmospheric depth, dust or smoke in the air, and distant figures or architecture reinforcing the scale.Lighting should feel dramatic and cinematic, similar to a modern historical epic film, with warm sunlight cutting through dust or clouds, creating strong highlights and deep shadows. Render the image with the visual style of a high-budget historical blockbuster, featuring: • cinematic color grading • dramatic lighting • detailed costume textures • atmospheric depth and scale.The final image should resemble a frame from an epic ancient Roman film, where the subject appears as a heroic character in a grand historical narrative.Preserve realism, natural anatomy, and believable materials so the result looks like a real cinematic scene rather than an illustration or costume portrait.\",\"templateType\":\"I2I\",\"postID\":\"9d8f6c8e-3507-4f38-a022-3c14f6fbbd91\",\"description\":\"Travel back in time to the age of great Roman Emperors.\"},{\"title\":\"Fire Horse\",\"imagePrompt\":\"Subject is riding on a beautiful vibrantly red giant porcelain horse, positioned in front of the great wall of china. Slightly grainy film texture. Low dramatic epic angle. Beautiful framing. High resolution, up close framing of subject upper body. Low light background. Subject has a neutral facial expression.\",\"videoPrompt\":\"Horse begins galloping, background becomes darker and golden/yellow fireworks go off in background.\",\"templateType\":\"I2I2V\",\"postID\":\"808ab93b-ec7f-4052-964b-5174c908db1d\",\"description\":\"Rides a giant red porcelain horse galloping by the Great Wall with fireworks.\"},{\"title\":\"Video Game\",\"imagePrompt\":\"A character rendered in authentic early-2000s PlayStation 2 / Nintendo 64 video game style, with very low-poly geometry, blocky limbs, and angular facial features. The character has simple, flat textures, visible texture stretching, and low-resolution diffuse maps, with no skin pores, no fine detail, and no realism.\",\"templateType\":\"I2I\",\"postID\":\"f51ad8c5-9dfa-4436-8c5a-9f0e95f78483\",\"description\":\"Turns life into a video game.\"},{\"title\":\"Ad Astra\",\"imagePrompt\":\"The subjects are suspended in space, wearing spacesuits. Retain likeness and any original head accessories if present. Entire image is black and white.\",\"videoPrompt\":\"They are gently floating through space, subtly happy and in awe.\",\"templateType\":\"I2I2V\",\"postID\":\"9068fa4b-4805-467c-b2d3-0cb503356052\",\"description\":\"Floats you through space in a black-and-white spacesuit.\"},{\"title\":\"Balloon Flight\",\"imagePrompt\":\"Turn the core characters from the image into inflated, glossy vinyl Balloons figure with huge, oversized eyes, gently floating and rising up into the sky. The balloons only have the overinflated, rounded upper body and arms. A thread holds the bottom of the balloon. Highly reflective smooth plastic surface, subtle seam lines, gentle pressure wrinkles, shiny toy-like finish, soft, inflated human face with slightly simplified features, cinematic studio lighting, centered portrait, ultra-detailed, polished inflatable character aesthetic， medium close-up shot.\",\"videoPrompt\":\"The printed eyes of balloons are static; the balloons float purely upward; the balloons themselves are completely rigid, devoid of any movement. The camera tracks the balloon statically, ensuring it remains centered within the center of the frame.\",\"templateType\":\"I2I2V\",\"postID\":\"3075a66c-40f6-47ed-b86a-6a649a7bdf0b\",\"description\":\"Turn yourself into a balloon and rise high into the sky.\"},{\"title\":\"Go Skiing\",\"imagePrompt\":\"Subjects skiing down a snowy mountain. Preserve outfit.\",\"videoPrompt\":\"Skiing in a zigzag carving motion.\",\"templateType\":\"I2I2V\",\"postID\":\"099aeb0e-6221-4a45-889c-f90b6626a627\",\"description\":\"Skiing down a snowy mountain carving turns.\"},{\"title\":\"Laser Fight\",\"imagePrompt\":\"the subjects each hold a blue, futuristic lightsaber sword in their hands\",\"videoPrompt\":\"the characters start fighting with the lightsaber in a controlled, elegant way. cinematic darkness emerges.\",\"templateType\":\"I2I2V\",\"postID\":\"c9614d47-b75d-40c2-b9cf-97394c099b9d\",\"description\":\"Fights with glowing blue lightsabers.\"},{\"postID\":\"468c842f-26c3-4f08-8d50-ee3e6b60b1b1\",\"title\":\"Future Family\",\"prompt\":\"Add their children looking like them and dressed similarly.\",\"description\":\"Adds kids who look like you.\"},{\"postID\":\"7be5f03e-0484-4a12-aad7-f14159820ffa\",\"title\":\"Club Beats\",\"prompt\":\"Create a short video animation starting from the uploaded static image of a person. The subject(s) begins without any accessories, facing forward with a neutral expression. Smoothly animate them reaching up and putting on large black visor-style sunglasses that cover their eyes completely, followed by sliding on bulky over-ear headphones or ear protectors. Once equipped, have them start nodding their head rhythmically to upbeat music, with subtle body sways, maintaining a cool, intense vibe like a video game character. Cinematic lighting illuminates the face of the subject and the camera dolly's in as the subject continues bopping their head, keeping the body movement realistic and fluid.\",\"description\":\"Puts on sunglasses and headphones then grooves to club beats.\"},{\"title\":\"Simulationship\",\"imagePrompt\":\"The subject is running in a field with a few flowers, ultra grainy and low saturation 90's film aesthetic retro, holding the hand of silhouette figure that has a vintage neon green grid pattern (almost like a simulation character), they are running through a grassy field on a sunny day, a few flowers in the field. Both subjects are joyous.\",\"videoPrompt\":\"Subjects continue holding hands playfully running through the grass, almost dream-like.\",\"templateType\":\"I2I2V\",\"postID\":\"117cd5d1-ba11-4e93-bd93-160c4f92babf\",\"description\":\"Runs hand-in-hand through a flower field with a glowing simulation figure.\"},{\"postID\":\"ad4741bf-8f64-43f8-bba4-9097b5b5a14d\",\"title\":\"Let it Snow\",\"prompt\":\"A powdery snowball thrown at the subject hitting them in their face, snowball bursting into powdery snow on impact. Funny and harmless. The character looks slightly upset looking in the direction from where the snowball came and calling toward that direction at someone beyond the camera.\",\"description\":\"Gets hit in the face by a snowball.\"},{\"postID\":\"55c2e33d-94f1-49e2-bee4-0984cb28e7be\",\"title\":\"Bear Buddy\",\"prompt\":\"A giant alive and real polar bear walks up to the subject sitting next to the subject, and the subject pats the bear as the bear softly snuggles the subject. One continuous shot, no cuts.\",\"description\":\"Cuddles with a giant friendly polar bear.\"},{\"postID\":\"3c36fe5c-01ce-4a74-8102-d8eaa8443e66\",\"title\":\"Cuddle a Squirrel\",\"prompt\":\"A little squirrel runs up the shoulder of the subject, and they touch noses softly and sweetly.\",\"description\":\"A squirrel climbs your shoulder for a nose touch.\"},{\"postID\":\"7a668278-27c6-497e-96ea-552740c4ab15\",\"title\":\"Helicopter Escape\",\"prompt\":\"A rescue rope drops from above as the subject grabs it and vanishes skyward. Action-packed, cinematic getaway\",\"description\":\"Grabs a rope and escapes by helicopter.\"},{\"title\":\"Sunny Morning\",\"imagePrompt\":\"Warm, nostalgic 35mm film still aesthetic with a soft 1970s/early-80s pastoral-cinema vibe. Golden-hour backlight flooding the frame: rich amber/orange highlights, warm skin tones, and honey-colored grasses. Gentle film halation (soft glowing bloom around bright areas and sunlit edges), slightly lifted blacks with a mild matte fade, and smooth highlight roll-off (no harsh clipping). Medium-wide composition with the subject placed left-of-frame and lots of negative space to the right; a calm, observational, “quiet moment” tone. Shallow-to-moderate depth of field: foreground grasses softly blur into the lens, subject readable but not razor sharp, background trees softened. Naturalistic contrast, slightly low micro-contrast, creamy texture. Subtle film grain throughout (fine, organic grain), mild softness and lens character (gentle vignetting, slight flare), and a restrained color palette that leans warm gold + muted greens. Overall look: dreamy, intimate, sun-drenched, painterly realism like a still from an art-house coming-of-age film.\",\"templateType\":\"I2I\",\"postID\":\"7ad8ee24-d5d5-4688-84bb-b221cddc5dd7\",\"description\":\"Warm golden-hour morning scene with film look.\"}]},\"enable_settings_subscription_section_v2\":true,\"show_early_access_models_setting\":false,\"require_connector_feedback\":false,\"enable_pipeline_templates\":true,\"enable_gateway_chat\":true,\"nsfw_enabled\":false,\"disable_sharing\":false,\"disable_dev_models\":true,\"enable_table_paste_as_markdown\":true,\"enable_dictation_refinement\":true,\"enable_gmail_integration\":true,\"enable_pbt\":true,\"enable_feedback_attachments\":true,\"enable_code_terminal\":false,\"enable_google_drive_integration_imagine\":true,\"restrict_edit_and_regen_to_latest_msg\":false,\"imagine_show_paywall_web\":false,\"use_exceljs\":false,\"enable_grok_computer\":true,\"xlsx_exceljs_light_default\":true,\"hide_old_debug_tools\":true,\"show_files_explorer_shared_page\":true,\"enable_google_drive_search_tool\":true,\"enable_web_imagine_multiselect\":true,\"enable_web_imagine_compact_view\":true,\"supergrok_branding_query_bar_animation_enabled\":false,\"enable_voice_safari_audio_warmup\":false,\"enable_ios_audio_session_override\":false,\"connector_reauth_exp_web\":false,\"template_preset_configs\":{\"render_quality\":true,\"template_name\":\"Professional\",\"video_extension_enabled\":false,\"template_grouper_name\":\"Timeline\",\"template_backup\":\"Classic\",\"imagine_agent_models\":[],\"imagine_agent_model\":\"imagine-agent-mode-grok-4-5\",\"imagine_agent_model_fast\":\"plane:grok-imagine-agent-director\",\"enable_moodboard\":true,\"enable_crop\":true,\"enable_extract_frame\":true,\"enable_stitch\":true,\"enable_nux_modal\":false,\"enable_new_imagine_nux_modal\":true,\"enable_nux_tooltip\":true,\"allow_report_bug\":true,\"nux_modal_video_src\":\"https://data.x.ai/releases/imagine/video-1-5/1_5_video_launch.mp4\",\"nux_tooltip_video_src\":\"https://storage.googleapis.com/grok-web-public/imagine-agent-nux-tooltip-video.mp4\",\"nux_tooltip_poster_src\":\"https://storage.googleapis.com/grok-web-public/imagine-agent-nux-tooltip-poster.jpg\",\"nux_modal_title\":\"Introducing Imagine Agent Mode (Beta)\",\"nux_modal_description\":\"Brainstorm with your agent, generate and edit images, then turn them into videos, and stitch videos together to create longer videos all in one place.\",\"nux_modal_cta\":\"Try Agent Mode\",\"nux_tooltip_title\":\"Introducing Imagine Agent Mode (Beta)\",\"nux_tooltip_description\":\"Brainstorm with your agent, generate and edit images, then turn them into videos, and stitch videos together to create longer videos all in one place.\",\"enable_image_gen_think_harder\":true,\"enable_direct_gen_modes\":true,\"enable_recent_gen_placement\":true,\"new_imagine_nux_modal_video_src\":\"https://data.x.ai/releases/imagine/video-1-5/1_5_video_launch.mp4\",\"new_imagine_nux_modal_title\":\"\",\"new_imagine_nux_modal_cta\":\"Get Started\",\"region_edit\":true,\"segment\":true},\"imagine-templates-config\":{},\"enable_memory_summary\":false,\"show_privacy_policy_notice\":false,\"enable_gateway_chat_v2\":false,\"enable_attach_menu\":false,\"enable_better_upscale_web\":false,\"subscriptions_cancel_flow_downgrade_step_enabled\":true,\"enable_imagine_paywall\":true,\"chat_v2_rollout\":{\"enabled_internal\":false,\"enabled_external\":false,\"beta_internal\":false,\"beta_external\":false,\"beta_mobile_internal\":false,\"beta_mobile_external\":false},\"enable_imagine_paywall_testimonials\":true,\"enable_imagine_paywall_gallery_carousel\":true,\"web_enable_payment_lapsed_banner\":{\"enable\":false},\"web_payment_lapsed_banner\":{\"enabled\":false},\"web_response_throttle_banner\":{\"dismissable\":true},\"enable_imagine_template_x_handle\":true,\"import_memory_prompt\":\"Export all of my stored memories and any context you've learned about me from past conversations. Preserve my words verbatim where possible, especially for instructions and preferences.\\n\\n## Categories (output in this order):\\n\\n1. **Instructions**: Rules I've explicitly asked you to follow going forward — tone, format, style, \\\"always do X\\\", \\\"never do Y\\\", and corrections to your behavior. Only include rules from stored memories, not from conversations.\\n\\n2. **Identity**: Name, age, location, education, family, relationships, languages, and personal interests.\\n\\n3. **Career**: Current and past roles, companies, and general skill areas.\\n\\n4. **Projects**: Projects I meaningfully built or committed to. Ideally ONE entry per project. Include what it does, current status, and any key decisions. Use the project name or a short descriptor as the first words of the entry.\\n\\n5. **Preferences**: Opinions, tastes, and working-style preferences that apply broadly.\\n\\n## Format:\\n\\nUse section headers for each category. Within each category, list one entry per line, sorted by oldest date first. Format each line as:\\n\\n[YYYY-MM-DD] - Entry content here.\\n\\nIf no date is known, use [unknown] instead.\\n\\n## Output:\\n- Wrap the entire export in a single code block for easy copying.\\n- After the code block, state whether this is the complete set or if more remain.\",\"enable_memory_import\":true,\"query_bar_accessibility\":{\"enabled\":true,\"text\":\"Agent (Beta)\",\"dynamic_pills\":[{\"icon\":\"photo-stack\",\"prompts\":[{\"label\":\"Create Worlds\",\"prompt\":\"First, generate 6 world concepts and their infographics. Then show a scene from each world.\"},{\"label\":\"Character Sheets\",\"prompt\":\"First, create 6 character sheets in landscape. Then edit each sheet to get a portrait model of each character.\"}]},{\"icon\":\"film-roll\",\"prompts\":[{\"label\":\"Short Film\",\"prompt\":\"Give me 3 quick ideas for a 1 minute film. Then, generate an image of the main character in each film. Then use that image to create a movie poster for each film.\"},{\"label\":\"Manga One-Shot\",\"prompt\":\"Give me 3 quick ideas for a short manga one-shot. For each, generate the main character, then create a sequence of manga panels for a key scene.\"}]},{\"icon\":\"camera\",\"prompts\":[{\"label\":\"UGC Product Stories\",\"prompt\":\"Generate 3 distinct products and 3 diverse realistic everyday models. First, create reference images of each product and natural lifestyle portraits for each model. Then develop 3 UGC concept stories mixing the products and models. For each story, generate candid user-style photos or keyframes of the model using the product, then use those images to create complete social media packs (carousels, Stories, Reels covers, and posts).\"},{\"label\":\"UGC Scenes\",\"prompt\":\"Generate 3 authentic UGC-style product-in-use scene concepts showing everyday people with the product. For each, first create candid, natural-looking user photos from different angles, then use the strongest images to build complete ready-to-post Instagram/TikTok carousels, Reels covers, and story templates\"}]},{\"icon\":\"layout\",\"prompts\":[{\"label\":\"Brand Identity\",\"prompt\":\"Create 2 distinct brand identity directions for a product or company. For each direction, first generate core visual assets as high-quality images (logo variations, color palette, typography samples), then use those generated images to produce realistic application mockups on business cards, website headers, packaging, and marketing materials.\"},{\"label\":\"Cover Concepts\",\"prompt\":\"Create 4 different cover concepts for a report, ebook, whitepaper, or book. Then produce full mockups showing the cover in 3D and in-context usage.\"}]}]},\"enable_imagine_multi_ref_edit_template\":false,\"supergrok_paywall_free_trial_zero_price\":true,\"supergrok_upsells_free_trial_zero_price\":true,\"enable_imagine_lightbox_view_tabs\":false,\"disable_report_issue\":false,\"disable_conversation_search\":false,\"enable_chat_image_make_video\":false,\"can_access_collections\":true,\"hide_files_page\":false,\"can_access_team_settings\":true,\"enable_imagine_post_nav\":true,\"enable_imagine_in_app_auth\":false,\"enable_file_mentions\":false,\"enable_imagine_template_featuring_opt_in\":true,\"enable_update_payment_method_in_settings\":false,\"enable_atlas_type_to_prompt\":true,\"show_remaining_queries_toast\":false,\"enable_rate_limit_logged_out_copy_update\":true,\"enable_imagine_native_media_sizing\":true,\"SHOW_ANON_LOGIN\":true,\"enable_grok_computer_workdir_submenu\":true,\"grok_build_access_gate_web\":{\"allow_access\":false,\"message\":\"SuperGrok Heavy subscription required\",\"url\":\"https://grok.com/#subscribe\"},\"temp_supergrok_heavy_discount_enabled\":false,\"show_skills_sample_prompts\":true,\"enable_community_link\":true,\"enable_age_gate\":true,\"enable_dob_lock\":true,\"enable_imagine_credit_quota_notice\":true,\"enable_imagine_credit_quota_toast\":true,\"enable_grok_computer_onedrive_workdir\":false,\"disable_imagine_video_mode\":false,\"enable_castle_integration\":false,\"enable_structured_chunks\":false,\"enable_imagine_credit_quota_notice_low\":true,\"grok_build_supergrok_enabled\":false,\"grok_web_enable_mcp_apps_renderer\":true,\"grok_web_enable_connector_keyword_match_upsell\":false,\"enable_new_sharing_modal\":false,\"use_text_dob_year_input\":true,\"disable_threads\":true,\"enable_query_bar_smooth_transition\":true,\"enable_stream_throttle\":false,\"enable_grok_build_for_enterprise\":false,\"grok_web_credit_topup\":false,\"enable_skill_sharing\":true,\"imagine-caption-presets\":{\"Standard\":\"default\",\"Standout\":\"standout\",\"Lively\":\"lively\"},\"use_gw_in_chat\":true,\"enable_imagine_post_action_reorder\":false,\"build_tag_v2\":true,\"enable_experimental_reporting\":true,\"enable_settings_billing_tab\":true,\"show-new-settings-dialog\":true,\"enable_grok_computer_workdir_sharepoint_and_onedrive\":false,\"lunar-newt\":false,\"supergrok_paywall_rocket_theme\":false,\"supergrok_paywall_interval_selector\":\"both\",\"supergrok_paywall_category_selector\":\"both\",\"supergrok_paywall_hide_lite_on_promo_enabled\":false,\"enable_thinking_canvas\":true,\"supergrok_paywall_mobile_supergrok_first_enabled\":true,\"supergrok_upsell_small_promo_countdown_enabled\":false,\"web-flexible-video\":false,\"enable_imagine_limited_time_upsell_pill\":false,\"enable_settings_upsell_promo_banner\":false,\"enable_imagine_lightbox_side_panel\":true,\"disable_team_sharing\":true,\"web-imagine-projects-view\":true,\"enterprise_usage_conversation_topics_pie_chart_enabled\":true,\"imagine_upscale_2\":false,\"enable_app_open_paywall\":false,\"hide_new_chat_top_nav\":true,\"HIDE_IMAGINE_LINK\":true,\"enable_voice_thumbs_feedback\":true,\"supergrok_paywall_clickable_card\":false,\"office_plugin_cta\":true,\"enable_message_queue\":true,\"enable_imagine_search_index_on_demand\":false,\"enable_imagine_saved_search_on_demand\":false,\"supergrok_paywall_hide_offer_countdown_enabled\":true,\"project_stargaze_web\":false,\"enable_tos_gate\":true,\"gateway_config\":{\"heartbeat_active_ms\":3000,\"heartbeat_idle_ms\":30000},\"enable_imagine_agent_connectors\":true,\"enable_imagine_usage_limit_warning_toasts\":true,\"projects_v2_web\":true,\"enable_active_promotion_section_in_billing_tab\":true,\"verified_skills\":false,\"show_usage_pool_announcement_modal\":false,\"enable_verified_skills\":false,\"enable_imagine_agent_templates\":false,\"enable_remove_credit_payment_method\":true,\"enable_imagine_image_count\":true,\"imagine_resolve_direct_load_container\":true,\"imagine_agent_templates\":[{\"id\":\"imagine-photo-edit\",\"title\":\"Photo Edit\",\"description\":\"Upload a photo and pick one precise edit — enhance, remove an object, professional polish, change the background, isolate a person, black \u0026 white, cozy warm, sharpen details, or blur the background.\",\"category\":\"Photo Tools\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image Editing\"}],\"presetInputs\":[{\"id\":\"edit\",\"label\":\"Edit\",\"description\":\"Pick exactly one edit to apply to your photo.\",\"required\":true,\"multiSelect\":false,\"options\":[{\"label\":\"Photo enhance\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/photo_edit/photo_edit_photo_enhance.jpg?v=3\",\"value\":\"Photo enhance\",\"prompt\":\"Dramatically improve this photo into a polished, professional-quality portrait while keeping the same person, same pose, same clothing, and same location. Re-light the subject with flattering soft directional key light and gentle fill so the face is bright, dimensional, and clearly separated from the background — eliminate flat, dull, or overhead lighting. Add depth of field: render the background with natural, creamy optical blur so the subject pops, and clean up background clutter and distracting bright spots. Apply a rich, film-like color grade with deep clean blacks, luminous highlights, and vivid but natural color.\\n\\nCritical constraints: preserve the person's exact same face, eyes, skin and appearance.\"},{\"label\":\"Remove Object\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/photo_edit/photo_edit_remove_object.jpg?v=5\",\"value\":\"Remove Object\",\"prompt\":\"Remove the specific unwanted object or person the user describes. Fill the area naturally so it looks like the object was never there. Preserve the exact appearance of the person that's the main subject of the photo. Do not change anything about them, just remove the object they want to remove.\"},{\"label\":\"Professional Polish\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/photo_edit/photo_edit_professional_polish.jpg?v=1\",\"value\":\"Professional Polish\",\"prompt\":\"Transform this casual photo into a polished, professional-quality portrait of the exact same person, clothing, jewelry, and location. Re-light the subject with soft directional key light from a flattering angle plus gentle fill so their face is bright, dimensional, and clearly separated from the background, eliminating flat or overhead lighting. Add natural creamy optical depth of field that renders the background with smooth bokeh blur, cleaning up clutter and distracting bright spots so the subject pops forward. Apply a rich film-like color grade featuring deep clean blacks, luminous highlights, and vivid yet natural colors. The final image must look like the same person captured by a professional photographer with excellent lighting and a fast lens.\"},{\"label\":\"Background Changer\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/photo_edit/photo_edit_background_changer.jpg?v=6\",\"value\":\"Background Changer\",\"prompt\":\"Replace the entire background with a new one that the user describes. Keep the main subject sharp and correctly lit for the new background. Make sure that the proportion of the main subject of the picture is logical compared to the background proportions so the main subject does not lok overly big or overly small compared to the new background.\"},{\"label\":\"Isolate Person\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/photo_edit/photo_edit_isolate_person.jpg?v=5\",\"value\":\"Isolate Person\",\"prompt\":\"Isolate the person the user describes into a portrait of them in the same setting but by themselves. Remove everyone else just keep the original setting and the close up portrait of the person. If the person is wearing anything on their face, keep it exactly the same. Maintain their facial features precisely.\"},{\"label\":\"Black \u0026 White\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/photo_edit/photo_edit_black_and_white.jpg?v=3\",\"value\":\"Black \u0026 White\",\"prompt\":\"Convert this photograph into a beautiful black and white image with the quality of fine-art film photography. Aim for a balanced, correctly exposed result — neither dark and heavy nor bright and washed out. Build a full tonal range: rich blacks that hold visible shadow detail, bright highlights that retain full detail and never blow out to pure white, and well-distributed midtones with clear separation between tonal steps.\\n\\nRender the skin just above middle gray — luminous and flattering, but with clear tonal modeling and visible gradation across the face. Skin should never approach pure white or lose highlight detail; retain detail in the brightest areas of the forehead, nose, and cheekbones. Light the face with soft diffused light that wraps gently, giving soft-edged shadows and no harsh dark blotches. Keep natural skin texture present but rendered softly — do not sharpen, crunch, or add micro-contrast to skin.\\n\\nCarry the image's contrast in the hair, clothing, background, and surrounding scene rather than in the face. Separate the subject from the background through luminance difference. Sharpen and add detail to the eyes, eyelashes, brows, and hair, and give the eyes bright clear catchlights.\\n\\nRender with fine organic film grain and smooth natural highlight roll-off, in the character of a classic portrait film stock like Ilford Delta 100 — clean, luminous, medium contrast. No color anywhere, no sepia or split-toning. Avoid a muddy or underexposed look, avoid crushed blacks, and equally avoid an overexposed, blown-out, or hazy washed-out rendering. Protect highlight detail above all.\"},{\"label\":\"Cozy Warm\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/photo_edit/photo_edit_cozy_warm.jpg?v=3\",\"value\":\"Cozy Warm\",\"prompt\":\"Grade this photograph with a warm, cozy, inviting atmosphere while keeping it full color and natural. Shift the lighting toward golden-hour warmth: render the light sources and highlights with a soft amber-golden glow, as if lit by late afternoon sun or warm lamplight. Keep the shadows neutral to very slightly cool so the image stays dimensional and never muddy or uniformly orange.\\n\\nAdd a gentle soft-light bloom around bright areas and light sources, with smooth luminous highlight roll-off. Lift the blacks slightly for a soft, film-like, enveloping feel rather than harsh contrast. Enrich warm tones in wood, fabric, hair, and warm surfaces, and let cool elements in the scene stay cool so the warmth reads as light rather than a color cast. Keep whites recognizably white — warm-tinted, not yellow.\\n\\nCritical constraints: preserve the subject's natural skin tone and undertone. Skin should look warmly lit and healthy, never orange, ruddy, sunburned, or jaundiced. Do not lighten, whiten, smooth, or even out skin, and keep natural texture including pores, fine lines, and freckles. Do not reshape faces or alter proportions. This is a full-color image — absolutely no sepia, no monochrome, no vintage yellow filter, no uniform color overlay. The result should feel like a warmly lit moment captured on film: cozy, soft, and inviting, with natural color intact.\"},{\"label\":\"Sharpen Details\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/photo_edit/photo_edit_sharpen_details.jpg?v=4\",\"value\":\"Sharpen Details\",\"prompt\":\"Increase sharpness, texture, and micro-contrast throughout the image for crisper, more defined details. Enhance edge definition and fine detail in the hair, clothing, eyes, and background while keeping the overall look natural and realistic. Do not change colors, tones, lighting, composition, or the subject's appearance beyond the added clarity and sharpness.\"},{\"label\":\"Blur Background\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/photo_edit/photo_edit_blur_background.jpg?v=1\",\"value\":\"Blur Background\",\"prompt\":\"Keep the main subject sharp and add natural background blur/bokeh.\"}]}],\"textInputs\":[{\"id\":\"details\",\"label\":\"Details\",\"required\":false,\"placeholder\":\"e.g. remove the cars / change background to a beach — needed only for Remove Object, Background Changer, or Isolate Person\"}],\"imageInputs\":[{\"id\":\"photo\",\"label\":\"Your photo\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"inputOrder\":[\"photo\",\"edit\",\"details\"],\"promptTemplate\":\"You are a precise mobile photo editor.\\n\\nThe user has uploaded a photo and will choose exactly one edit from the list below.\\n\\nApply ONLY that single edit.\\n\\nKeep the original subject, composition, and framing unless the edit specifically requires changing them.\\n\\nDo not add extra objects or apply any other adjustments.\\n\\nOutput a clean, high-quality result.\\n\\nAvailable edits:\\n\\n1. Photo enhance: Dramatically improve this photo into a polished, professional-quality portrait while keeping the same person, same pose, same clothing, and same location. Re-light the subject with flattering soft directional key light and gentle fill so the face is bright, dimensional, and clearly separated from the background — eliminate flat, dull, or overhead lighting. Add depth of field: render the background with natural, creamy optical blur so the subject pops, and clean up background clutter and distracting bright spots. Apply a rich, film-like color grade with deep clean blacks, luminous highlights, and vivid but natural color.\\n\\nCritical constraints: preserve the person's exact same face, eyes, skin and appearance.\\n\\n2. Remove Object — Remove the specific unwanted object or person the user describes. Fill the area naturally so it looks like the object was never there. Preserve the exact appearance of the person that's the main subject of the photo. Do not change anything about them, just remove the object they want to remove.\\n\\n3. Professional Polish — Transform this casual photo into a polished, professional-quality portrait of the exact same person, clothing, jewelry, and location. Re-light the subject with soft directional key light from a flattering angle plus gentle fill so their face is bright, dimensional, and clearly separated from the background, eliminating flat or overhead lighting. Add natural creamy optical depth of field that renders the background with smooth bokeh blur, cleaning up clutter and distracting bright spots so the subject pops forward. Apply a rich film-like color grade featuring deep clean blacks, luminous highlights, and vivid yet natural colors. The final image must look like the same person captured by a professional photographer with excellent lighting and a fast lens.\\n\\n4. Background Changer — Replace the entire background with a new one that the user describes. Keep the main subject sharp and correctly lit for the new background. Make sure that the proportion of the main subject of the picture is logical compared to the background proportions so the main subject does not lok overly big or overly small compared to the new background.\\n\\n5. Isolate Person — Isolate the person the user describes into a portrait of them in the same setting but by themselves. Remove everyone else just keep the original setting and the close up portrait of the person. If the person is wearing anything on their face, keep it exactly the same. Maintain their facial features precisely.\\n\\n6. Black \u0026 White — Convert this photograph into a beautiful black and white image with the quality of fine-art film photography. Aim for a balanced, correctly exposed result — neither dark and heavy nor bright and washed out. Build a full tonal range: rich blacks that hold visible shadow detail, bright highlights that retain full detail and never blow out to pure white, and well-distributed midtones with clear separation between tonal steps.\\n\\nRender the skin just above middle gray — luminous and flattering, but with clear tonal modeling and visible gradation across the face. Skin should never approach pure white or lose highlight detail; retain detail in the brightest areas of the forehead, nose, and cheekbones. Light the face with soft diffused light that wraps gently, giving soft-edged shadows and no harsh dark blotches. Keep natural skin texture present but rendered softly — do not sharpen, crunch, or add micro-contrast to skin.\\n\\nCarry the image's contrast in the hair, clothing, background, and surrounding scene rather than in the face. Separate the subject from the background through luminance difference. Sharpen and add detail to the eyes, eyelashes, brows, and hair, and give the eyes bright clear catchlights.\\n\\nRender with fine organic film grain and smooth natural highlight roll-off, in the character of a classic portrait film stock like Ilford Delta 100 — clean, luminous, medium contrast. No color anywhere, no sepia or split-toning. Avoid a muddy or underexposed look, avoid crushed blacks, and equally avoid an overexposed, blown-out, or hazy washed-out rendering. Protect highlight detail above all.\\n\\n7. Cozy Warm — Grade this photograph with a warm, cozy, inviting atmosphere while keeping it full color and natural. Shift the lighting toward golden-hour warmth: render the light sources and highlights with a soft amber-golden glow, as if lit by late afternoon sun or warm lamplight. Keep the shadows neutral to very slightly cool so the image stays dimensional and never muddy or uniformly orange.\\n\\nAdd a gentle soft-light bloom around bright areas and light sources, with smooth luminous highlight roll-off. Lift the blacks slightly for a soft, film-like, enveloping feel rather than harsh contrast. Enrich warm tones in wood, fabric, hair, and warm surfaces, and let cool elements in the scene stay cool so the warmth reads as light rather than a color cast. Keep whites recognizably white — warm-tinted, not yellow.\\n\\nCritical constraints: preserve the subject's natural skin tone and undertone. Skin should look warmly lit and healthy, never orange, ruddy, sunburned, or jaundiced. Do not lighten, whiten, smooth, or even out skin, and keep natural texture including pores, fine lines, and freckles. Do not reshape faces or alter proportions. This is a full-color image — absolutely no sepia, no monochrome, no vintage yellow filter, no uniform color overlay. The result should feel like a warmly lit moment captured on film: cozy, soft, and inviting, with natural color intact.\\n\\n8. Sharpen Details — Increase sharpness, texture, and micro-contrast throughout the image for crisper, more defined details. Enhance edge definition and fine detail in the hair, clothing, eyes, and background while keeping the overall look natural and realistic. Do not change colors, tones, lighting, composition, or the subject's appearance beyond the added clarity and sharpness.\\n\\n9. Blur Background — Keep the main subject sharp and add natural background blur/bokeh.\\n\\nWait for the user to select one option and provide any needed description, then apply it.\\n\\n=== USER INPUT ===\\n{{edit}}\\n\\nAdditional details: {{details}}\",\"coverVideoUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/photo_edit/photo_edit_cover.mp4?v=20260723\",\"coverImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/photo_edit/photo_edit_cover.jpg?v=20260722\",\"coverVerticalImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/photo_edit/photo_edit_vertical.jpg?v=20260722\",\"coverVerticalVideoUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/photo_edit/photo_edit_vertical.mp4?v=20260723\",\"variants\":[{\"inputs\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-19-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-19-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-33-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-33-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-48-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-48-output.jpg?v=20260723\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-01-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-01-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-24-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/photo_edit/variants/PHE-24-output.jpg?v=20260723\"}]},{\"id\":\"imagine-restyle\",\"title\":\"Reimagine\",\"description\":\"Reimagine your photo into a chosen look — chibi, comic, 3D, 70s street, 80s anime, or a warm Sunday-morning film look.\",\"category\":\"Photo Tools\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image Editing\"}],\"presetInputs\":[{\"id\":\"style\",\"label\":\"Style\",\"description\":\"Pick a style — or select several to get a version in each. Choosing one or several styles are both valid; each selected style produces its own separate restyled image.\",\"required\":true,\"multiSelect\":true,\"options\":[{\"label\":\"Chibi\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/restyle/restyle_chibi.jpg?v=3\",\"value\":\"Chibi\",\"prompt\":\"Create a cute anime chibi character of the person from the image, rendered as a high-quality glossy 3D blender style figurine: smooth reflective toy-like plastic materials, strong specular highlights, soft reflections, shiny surfaces. Preserve the person's original race, ethnicity, skin tone, hair color, facial likeness, eye color, and clothing colors precisely. Use classic chibi proportions with a very large head, small torso, simplified cute features, and large over-sized expressive sparkling eyes. Frame from the torso up with the upper body and head filling most of the frame. The person looks directly at the camera with an energetic, pose fit for this type of environment and scene. Preserve the environment that the person is in as the background, making it slightly bokeh.\"},{\"label\":\"Comic Book\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/restyle/restyle_comic_book.jpg?v=2\",\"value\":\"Comic Book\",\"prompt\":\"Transform the input image into an original comic-book / graphic-novel illustration style while preserving the subject's recognizable identity, pose, clothing, and everyday setting. Reinterpret the scene as a single panel from a slice-of-life indie comic: an ordinary, mundane 'day in the life' moment (e.g. sipping coffee, commuting, walking the dog, at a desk, cooking) — calm and relatable, NOT action or heroic. Use bold black ink outlines, clean confident linework, flat cel-shaded color blocks, and halftone / ben-day dot shading with subtle vintage newsprint texture. Keep the face recognizable but lightly stylized. Do NOT add superheroes, capes, costumes, masks, powers, logos, emblems, speech bubbles, sound effects, or any text. Absolutely no copyrighted, trademarked, or franchise characters or styles — a completely original, generic comic look applied to a real everyday scene.\"},{\"label\":\"3D Character\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/restyle/restyle_3d_character.jpg?v=3\",\"value\":\"3D Character\",\"prompt\":\"Create a charming cartoon character of the person from the image. Frame from the torso up with the upper body and head filling most of the frame. Pose, cute and charismatic personality, polished high-quality 3D cartoon style, highly detailed, professional illustration. Maintain the original face, structure and hair details. Preserve the environment that the person is in as the background, making it slightly bokeh.\"},{\"label\":\"70's Street Style\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/restyle/restyle_70s_street.jpg?v=4\",\"value\":\"70's Street Style\",\"prompt\":\"1970s NYC candid street photograph of the person or people (if there are multiple people in the user-uploaded photo) in typical 70s outfit, close up picture. avoid too much text in the background.\"},{\"label\":\"80's Anime\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/restyle/restyle_80s_anime.jpg?v=3\",\"value\":\"80's Anime\",\"prompt\":\"maintain original composition, facial expressions, and emotion of the original image. completely change the image style into: full illustrated ANIME STYLE: ultra high res video anime illustrated cartoon animated. retro 1980s aesthetic.,very moody lighting. in the style of a low res 1980s anime screengrab. VCR VHS. retro anime screencap. cartoon. CRT scanlines. bloom. halation. heavy film grain. Smooth perfect skin details.\"},{\"label\":\"Sunday Morning\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/restyle/restyle_sunday_morning.jpg?v=2\",\"value\":\"Sunday Morning\",\"prompt\":\"Warm, nostalgic 35mm film still aesthetic with a soft 1970s/early-80s pastoral-cinema vibe. Golden-hour backlight flooding the frame: rich amber/orange highlights, warm skin tones, and honey-colored grasses. Gentle film halation (soft glowing bloom around bright areas and sunlit edges), slightly lifted blacks with a mild matte fade, and smooth highlight roll-off (no harsh clipping). Medium-wide composition with the subject placed left-of-frame and lots of negative space to the right; a calm, observational, “quiet moment” tone. Shallow-to-moderate depth of field: foreground grasses softly blur into the lens, subject readable but not razor sharp, background trees softened. Naturalistic contrast, slightly low micro-contrast, creamy texture. Subtle film grain throughout (fine, organic grain), mild softness and lens character (gentle vignetting, slight flare), and a restrained color palette that leans warm gold + muted greens. Overall look: dreamy, intimate, sun-drenched, painterly realism like a still from an art-house coming-of-age film.\"}]}],\"textInputs\":[],\"imageInputs\":[{\"id\":\"photo\",\"label\":\"Your photo\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"inputOrder\":[\"photo\",\"style\"],\"promptTemplate\":\"You are a photo-restyling specialist inside Grok Imagine.\\nYour goal is to transform the person or subjects in the user's attached photo into the chosen style(s) given under USER INPUT.\\n\\nINTAKE — a photo attached IS the request: When this skill is invoked with a photo attached, treat that attachment as the explicit request to run. Begin restyling the attached photo right away using the selected style option(s) — do not ask the user to confirm, do not wait for further instruction, and do not ask the user to re-describe what they want. (If no photo is attached, ask the user to upload one.)\\n\\nThe USER INPUT below contains ONE OR MORE style specifications — each selected style is its own block, listed one after another. Treat every block as a separate, complete style spec.\\n\\nWorkflow (run automatically):\\n\\n1. Take the user's attached photo as the source image.\\n2. Determine how many styles are listed under USER INPUT:\\n   - If ONE style is listed: produce ONE restyled image for it.\\n   - If MULTIPLE styles are listed: produce a SEPARATE restyled image for EACH selected style — one output per style, each a distinct edit of the original photo. Never blend, merge, or combine multiple styles into a single image, and never output fewer images than the number of styles selected.\\n3. For each style, perform one image edit that restyles the photo into that style, applying that style's specification EXACTLY as written — every instruction it contains, in full.\\n4. Follow each selected style's own wording on what to preserve (identity, race, skin tone, likeness, hairstyle, clothing colors, composition, pose, expression, and framing) and what to change. When a style specifies its own composition, framing, or camera, follow that style; otherwise keep the original composition and framing intact.\\n5. Present the result(s) immediately — when multiple styles are selected, present one image per style.\\n\\nRules you must follow at all times:\\n\\n1. Receiving this skill invocation with a photo attached IS the request to run: execute the workflow immediately and automatically, in one shot, without asking for approval and without summarizing or describing this skill.\\n2. Never ask clarifying questions when a photo is attached. Only if no photo is attached, ask the user to upload one.\\n3. Apply each chosen style's specification verbatim and completely — do not paraphrase, shorten, or soften it, and never blend one style into another.\\n4. When several styles are selected, always output exactly one image per selected style — never a single combined image and never fewer images than styles selected.\\n5. Keep responses short and action-oriented.\\n\\n=== USER INPUT ===\\n{{style}}\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/restyle/restyle_cover.jpg?v=12\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/restyle/restyle_vertical.jpg?v=11\",\"variants\":[{\"inputs\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-04-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-04-output.jpg?v=20260723\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-09-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-09-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-44-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-44-output.jpg?v=20260723\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-07-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-07-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-12-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-12-output.jpg?v=20260723\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-41-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/restyle/variants/RST-41-output.jpg?v=20260723\"}]},{\"id\":\"imagine-aspect-ratio\",\"title\":\"Smart Resize\",\"description\":\"Reframe an image to new aspect ratios while keeping its style and key subjects.\",\"category\":\"Editing\",\"coverImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/aspect_ratio/Thumbnail_cover.jpg?v=4\",\"coverVerticalImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/aspect_ratio/vertical_cover_aspect.png?v=2\",\"aspectInputs\":[{\"id\":\"targetRatios\",\"label\":\"Target aspect ratio\",\"description\":\"Pick one or several — both are valid; each selected ratio produces its own converted image.\",\"multiSelect\":true,\"required\":true,\"options\":[{\"value\":\"16:9\",\"name\":\"Widescreen\"},{\"value\":\"3:2\",\"name\":\"Wide\"},{\"value\":\"1:1\",\"name\":\"Square\"},{\"value\":\"2:3\",\"name\":\"Tall\"},{\"value\":\"9:16\",\"name\":\"Vertical\"}]}],\"imageInputs\":[{\"id\":\"image\",\"label\":\"Reference image\",\"description\":\"Upload the image to reframe.\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"textInputs\":[],\"inputOrder\":[\"image\",\"targetRatios\"],\"promptTemplate\":\"You are an expert image editor using Grok Imagine.\\nTask: Convert the uploaded reference image to a new aspect ratio while preserving the original style, quality, colors, and key subjects.\\nTarget: `[User picks the aspect ratio they want — e.g. Instagram Story, TikTok, Square, 9:16 Vertical, 16:9 Widescreen]`\\nSupported Ratios \u0026 Common Platforms:\\n\\n- 2:3 Tall → Good for Pinterest, tall Instagram posts\\n- 3:2 Wide → Classic photography, some ads\\n- 1:1 Square → Instagram Post, Facebook Post, X Post\\n- 9:16 Vertical → Instagram Story, TikTok, Reels, YouTube Shorts\\n- 16:9 Widescreen → YouTube Thumbnail, X Post landscape, general video\\nInstructions:\\n- Keep the core subject(s) prominent and well-framed with smart cropping or recomposition.\\n- Maintain original artistic style, lighting, colors, and details exactly.\\n- High resolution, clean, professional output with no distortion or artifacts.\\n- Optimize composition for the chosen platform/ratio.\\nOutput only the final converted image in the exact requested aspect ratio.\\n\\n=== USER INPUT ===\\nTarget aspect ratios: {{targetRatios}}\\n\",\"variants\":[{\"inputs\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/ADR-12-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/ADR-12-output-16x9.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/SRZ-79-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/SRZ-79-output.jpg?v=20260723\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/ADR-22-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/ADR-22-output-1x1.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/ADR-20-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/ADR-20-output-16x9.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/SRZ-78-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/aspect_ratio/variants/SRZ-78-output.jpg?v=20260723\"}]},{\"id\":\"imagine-background-removal\",\"title\":\"BG Removal \u0026 Change\",\"description\":\"Isolate the main subject of any photo with high-fidelity cutout quality, then deliver it on the background you choose: genuine transparent alpha, a clean white studio backdrop, or a custom scene you describe.\",\"category\":\"Photo Tools\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/background_removal/background_removal_cover.jpg?v=9\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/background_removal/background_removal_vertical.jpg?v=7\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image\"},{\"label\":\"Output\",\"value\":\"Transparent PNG · White · Custom scene\"},{\"label\":\"Images\",\"value\":\"1\"}],\"presetInputs\":[{\"id\":\"backgroundMode\",\"label\":\"Background\",\"description\":\"What the subject should sit on after removal. Transparent = a real cutout on true alpha; White background = a clean white studio backdrop; Custom = a new scene you describe below. Defaults to Transparent.\",\"required\":true,\"options\":[{\"label\":\"Transparent\",\"value\":\"transparent\",\"prompt\":\"Transparent — return the subject on a genuine transparent alpha channel (a real PNG with true transparency). No background at all: no white or gray fill, no painted checkerboard, and no added canvas, padding, outline, or drop shadow.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/background_removal/bg-transparent.jpg?v=1\"},{\"label\":\"White background\",\"value\":\"white\",\"prompt\":\"White background — place the cut-out subject on a clean, uniform pure-white (#FFFFFF) studio background: evenly lit, no gradient, texture, vignette, or props. A subtle natural contact shadow directly under the subject is acceptable. Return an opaque image.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/background_removal/bg-white.jpg?v=1\"},{\"label\":\"Custom\",\"value\":\"custom\",\"prompt\":\"Custom background — remove the original background and place the subject, unchanged, onto the new background described under 'New background'. Recreate that scene photorealistically behind the subject and integrate it naturally — match perspective, scale, lighting direction, and color temperature, and add a grounded contact shadow or reflection as the scene calls for — while keeping the subject itself pixel-faithful.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/background_removal/bg-custom.jpg?v=1\"}]}],\"imageInputs\":[{\"id\":\"sourceImage\",\"label\":\"Image to cut out\",\"description\":\"The photo whose main subject should be isolated.\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"textInputs\":[{\"id\":\"customBackground\",\"label\":\"New background\",\"description\":\"Only for Custom: describe the scene the subject should be placed on (e.g. 'a rainy neon-lit city street at night' or 'a white marble kitchen counter in soft window light').\",\"required\":false,\"multiline\":true,\"placeholder\":\"Describe the new background scene (Custom mode only)\"},{\"id\":\"notes\",\"label\":\"Notes (optional)\",\"required\":false,\"placeholder\":\"Optional: anything specific you want\"}],\"inputOrder\":[\"backgroundMode\",\"sourceImage\",\"customBackground\",\"notes\"],\"promptTemplate\":\"You are running the Background Removal \u0026 Change skill. Take the attached photo, isolate its main subject with high-fidelity cutout quality, and deliver that subject on the BACKGROUND the user chose under USER INPUT (transparent, plain white, or a custom scene they describe).\\n\\nSUBJECT FIDELITY (all modes): identify the single main subject and preserve it pixel-faithfully — do not repaint, restyle, recolor, distort, crop, or regenerate the subject itself. Keep fine boundary detail intact: hair wisps, fur, thin structures, holes within the subject, and semi-transparent regions like glass, smoke, or sheer fabric must keep soft, accurate edges. Cleanly separate the subject from its original background with no leftover fragments, halos, color fringing, or matte lines.\\n\\nBACKGROUND TREATMENT: apply EXACTLY the background mode specified under USER INPUT (see 'Background'), and nothing else:\\n- Transparent: return a genuine transparent cutout — a real PNG with a true alpha channel, the subject on full transparency. Do NOT paint a checkerboard, white, or gray fill to fake transparency, and add no canvas, padding, outline, or drop shadow.\\n- White background: composite the subject on a clean, uniform pure-white studio backdrop — evenly lit, no gradient, texture, vignette, or props (a subtle natural contact shadow directly under the subject is fine). Output an opaque image.\\n- Custom background: remove the original background and place the subject, unchanged, into the NEW scene described under 'New background'. Render that scene photorealistically behind the subject and integrate it believably — match perspective, scale, lighting direction and color temperature, and add a grounded contact shadow or reflections as the scene calls for — while keeping the subject itself untouched. If no scene is described, use a plain neutral studio background.\\n\\nKeep the subject at its original resolution and framing. Do not add text, watermarks, borders, or extra objects beyond what the chosen background requires. Return one image.\\n\\nONE SHOT: do not ask questions; use sensible defaults for anything left open (if no background is chosen, default to Transparent).\\n\\n=== USER INPUT ===\\nBackground: {{backgroundMode}}\\nNew background: {{customBackground}}\\nNotes: {{notes}}\\n\",\"variants\":[]},{\"id\":\"imagine-ecommerce-listing\",\"title\":\"E-Commerce Photos\",\"description\":\"Turn one product photo into a complete 6-image e-commerce listing set — main on white, benefit infographic, lifestyle, in-use, detail close-up, and true-scale in-hand shot.\",\"category\":\"Marketing\",\"coverImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/ecommerce_photos/ecommerce_photos_cover.jpg?v=3\",\"coverVerticalImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/ecommerce_photos/ecommerce_photos_vertical.jpg?v=2\",\"settings\":[{\"label\":\"Aspect\",\"value\":\"1:1\"},{\"label\":\"Output\",\"value\":\"6 images\"}],\"imageInputs\":[{\"id\":\"productPhoto\",\"label\":\"Product photo\",\"description\":\"One clear, well-lit photo of your product — if it has a label, make sure it is readable.\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"textInputs\":[{\"id\":\"benefit1\",\"label\":\"Product benefit 1\",\"description\":\"Short benefit phrases (2–3). These are the ONLY claims that will appear on the images.\",\"required\":true,\"placeholder\":\"e.g., No guilt snack\"},{\"id\":\"benefit2\",\"label\":\"Product benefit 2\",\"required\":true,\"placeholder\":\"e.g., Extra crunchy\"},{\"id\":\"benefit3\",\"label\":\"Product benefit 3 (optional)\",\"required\":false,\"placeholder\":\"e.g., Sea salt finish\"},{\"id\":\"sizeHint\",\"label\":\"Size hint (optional)\",\"required\":false,\"placeholder\":\"e.g., \\\"about 7 in tall\\\" or \\\"fits in one hand\\\"\"}],\"promptTemplate\":\"Generate a complete e-commerce listing image set from the user's single product photo.\\nRules for every image:\\n- Treat the product photo as the exact product — identical shape, packaging, label, brand, and color. Photorealistic, never illustrated or cartoonish.\\n- Read the brand name, product type, and colors directly from the photo.\\n- Output each of the 6 images below as a separate square (1:1), high-resolution image — not a collage or grid.\\n- Keep lighting and color consistent across all 6 so they read as one set.\\n- Use ONLY the benefits I listed for any on-image text. Do not invent or add any claims, specs, numbers, ingredients, ratings, or customer quotes. If I filled in only 2 benefits, use 2 — never pad with a made-up one.\\n- Get scale right without guessing wildly. Read the quantity printed on the label (net weight, volume, or count, e.g. \\\"8 OZ\\\") and use it, plus the typical real-world size of this kind of product, to judge how big it actually is. When a hand or other familiar object appears with the product, keep that object at its normal real-world size and scale the product to match — accurate, believable scale matters more than a balanced-looking composition. If I gave a size hint, follow it.\\n\\nProduce these 6 images:\\n1. MAIN (pure white): the product on a pure white background (RGB 255,255,255), centered, filling ~85% of the frame, whole product visible and uncropped. Even studio lighting with a soft contact shadow beneath the product only — nothing touching the background. No props, no text, no added logos.\\n2. FEATURE INFOGRAPHIC: the product on a soft on-brand background with one clean callout per benefit I listed — a simple matched icon (identical line weight and size, evenly spaced) with its short label beneath. Use only my benefits as text. Polished and uncluttered.\\n3. LIFESTYLE: the product placed naturally in the real setting where it's used, warm natural light, aspirational but realistic. Product in focus and recognizable. No text.\\n4. IN USE: a person using the product the correct way for its type — applying, wearing, holding, operating, or (if it's an open drink) sipping it. Real-looking hands and skin, product label facing the camera. Show it open/active if that's how it's used, never sealed.\\n5. DETAIL CLOSE-UP: an extreme close-up of the product's key quality signal — texture, material, finish, or a defining feature — filling the frame, crisp focus. No packaging, no text.\\n6. SIZE / IN HAND: the product held in an adult person's hand against a clean neutral background, natural light. Keep the hand a normal adult size and render the product at its true real-world scale — use the quantity printed on the label and the typical size of this kind of product to get the proportion right. The goal is that a shopper instantly understands how big it is. Prioritize accurate scale over a pretty composition. No text.\\n\\n=== USER INPUT ===\\nProduct benefit 1: {{benefit1}}\\nProduct benefit 2: {{benefit2}}\\nProduct benefit 3: {{benefit3}}\\nSize hint: {{sizeHint}}\",\"inputOrder\":[\"productPhoto\",\"benefit1\",\"benefit2\",\"benefit3\",\"sizeHint\"],\"variants\":[]},{\"id\":\"imagine-collage\",\"title\":\"Photo Collage\",\"description\":\"Combine 2-16 of your photos into tasteful, shareable collages — pick one or more styles (one collage per style): pure grid, torn paper, bento cards, travel journal, or photo-booth strip.\",\"category\":\"Photo Tools\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image\"},{\"label\":\"Images\",\"value\":\"2-16\"},{\"label\":\"Orientation\",\"value\":\"Landscape / Portrait\"}],\"presetInputs\":[{\"id\":\"style\",\"label\":\"Styles\",\"description\":\"Pick one or more styles — you get one collage per selected style.\",\"required\":true,\"multiSelect\":true,\"options\":[{\"label\":\"Pure grid\",\"value\":\"pure-grid\",\"prompt\":\"a clean photo grid that ALWAYS fills the entire canvas, using exactly this partition for the photo count: 2 photos = two full-height side-by-side columns; 3 = one large cell filling the left two-thirds plus the other two photos stacked on the right third; 4 = a 2x2 grid; 5 = a top row of two cells over a bottom row of three; 6 = a 3x2 grid; more photos = the most balanced near-square grid. Cover-crop every photo INTO its cell so the cell is completely filled edge to edge — a photo never floats inside a cell; straight uniform white gutters (about 2% of the canvas) with the same slim outer border; zero slack canvas — no white area larger than a gutter anywhere; keep every photo's original colors exactly (no black-and-white conversion, no regrading); no frames, no tilting, no overlapping, no decoration — the grid IS the image\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/collage/style_pure_grid.jpg?v=4\"},{\"label\":\"Torn paper\",\"value\":\"torn-paper\",\"prompt\":\"each photo torn along irregular white ripped-paper edges, the torn pieces layered and overlapping on a warm kraft-beige paper backdrop with soft drop shadows — handmade, tactile, imperfect by design\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/collage/style_torn_paper.jpg?v=7\"},{\"label\":\"Bento cards\",\"value\":\"bento-cards\",\"prompt\":\"the photos in rounded-corner cards of deliberately varied sizes packed into a neat bento grid with even padding on a soft off-white background, subtle card shadows — modern app aesthetic, clean and friendly\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/collage/style_bento.jpg?v=6\"},{\"label\":\"Travel journal\",\"value\":\"travel-journal\",\"prompt\":\"an open travel-journal spread: the photos taped over a faint vintage map, a dotted route line wandering between them, a compass stamp and ticket-stub ephemera in the corners — short generic handwritten-style captions are part of this style and allowed\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/collage/style_travel_journal.jpg?v=7\"},{\"label\":\"Photo-booth strip\",\"value\":\"photo-booth-strip\",\"prompt\":\"one pristine vertical photo-booth strip filling the canvas height, shot perfectly straight and flat-on (no tilt, no perspective): exactly one equal frame per photo stacked inside the strip with even white borders, and EVERY frame completely filled by its photo — cover-crop each photo into its frame edge to edge, a photo never floats small inside a frame; crisp print quality, plain warm off-white background, barely-there soft shadow — iconic, symmetrical, clean\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/collage/style_booth_strip.jpg?v=8\"}]}],\"aspectInputs\":[{\"id\":\"orientation\",\"label\":\"Orientation\",\"description\":\"Landscape or portrait — the whole collage is composed to fill that canvas shape.\",\"required\":true,\"options\":[{\"value\":\"2:3\",\"name\":\"Portrait\",\"prompt\":\"a PORTRAIT canvas with a 2:3 vertical aspect ratio (clearly taller than wide) — lay the whole collage out to FILL this tall canvas edge to edge, adapting the cell arrangement, proportions and gutters to the vertical format (favor taller stacks); never letterbox, pad or leave the canvas partly empty\"},{\"value\":\"3:2\",\"name\":\"Landscape\",\"prompt\":\"a LANDSCAPE canvas with a 3:2 horizontal aspect ratio (clearly wider than tall) — lay the whole collage out to FILL this wide canvas edge to edge, adapting the cell arrangement, proportions and gutters to the horizontal format (favor wider rows); never letterbox, pad or leave the canvas partly empty\"}]}],\"textInputs\":[{\"id\":\"notes\",\"label\":\"Notes (optional)\",\"required\":false,\"placeholder\":\"Optional: anything specific you want\"}],\"imageInputs\":[{\"id\":\"photos\",\"label\":\"Your photos\",\"description\":\"2 to 16 photos to combine — every photo you attach will appear in the collage exactly once.\",\"required\":true,\"minImages\":2,\"maxImages\":16}],\"inputOrder\":[\"photos\",\"style\",\"orientation\"],\"promptTemplate\":\"Combine ALL attached photos into tasteful, shareable photo COLLAGES in the style(s) specified under USER INPUT. One or more styles may be listed — generate exactly ONE collage image PER listed style; each collage must contain ALL attached photos, composed in that style. Follow each style's structure precisely: cell placement, shapes, relative sizes and gutters are part of the spec, not suggestions.\\n\\nAesthetic vibe (backdrop, decorations, accent palette): READ the attached photos as a set first — who is in them, the occasion, the dominant colors, the energy (rowdy party, formal ceremony, outdoor adventure, family warmth, vintage memories) — and match the backdrop, decorations and accent palette to THAT mood. The decoration style must fit the people and occasion shown: never cutesy hearts or pastel confetti on a formal, masculine or adventurous set; party sets may be festive; formal or historic sets stay restrained and dignified. When in doubt, decorate less.\\n\\nEvery collage must look like a polished template from a premium mobile collage app — consistent gutters, aligned edges, deliberate composition — never photos scattered arbitrarily on a plain background.\\n\\nCanvas orientation: render EVERY collage on the canvas shape specified under USER INPUT (landscape or portrait). The chosen orientation is a hard requirement — the finished image's aspect ratio must match it, and the layout must be composed to fill that whole canvas edge to edge (adapt cell sizes, row/column counts and gutters to the orientation; never pad, letterbox or leave slack canvas to fake the shape).\\n\\nHard rules (apply to EVERY collage): every one of the attached photos must appear in each collage exactly once — none omitted, none duplicated, and do not invent extra photos that were not attached. Keep every photo recognizably itself: preserve faces, identities, subjects, colors and composition (cropping to fit a cell is fine; re-rendering or restyling the subjects is not). Do not add captions or any other text unless the selected style explicitly includes text elements. Output only the finished collage image(s) — one per requested style, nothing else.\\n\\n=== USER INPUT ===\\nStyles (one collage per listed style): {{style}}\\nCanvas orientation: {{orientation}}\\nExtra notes: {{notes}}\\n\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/collage/collage_cover.jpg?v=10\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/collage/collage_vertical.jpg?v=10\",\"variants\":[{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/collage/variants/designer-bento-2x3.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/collage/variants/designer-travel-journal-2x3.jpg?v=20260723\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/collage/variants/designer-pure-grid-2x3.jpg?v=20260723\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/collage/variants/designer-photo-booth-2x3.jpg\"}]},{\"id\":\"imagine-profile-picture\",\"title\":\"Profile Picture\",\"description\":\"Turn a casual photo into a standout social or dating profile picture — authentic-looking, like a friend caught you on a great day, never airbrushed or studio-fake.\",\"category\":\"Photo Tools\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image\"},{\"label\":\"Images\",\"value\":\"1\"}],\"presetInputs\":[{\"id\":\"clothing\",\"label\":\"Clothing\",\"description\":\"Choose whether to keep the exact outfit from your photo or be dressed in clothing that fits each scene.\",\"required\":true,\"default\":\"dress-for-scene\",\"multiSelect\":false,\"optionAspect\":\"square\",\"optionFit\":\"cover\",\"options\":[{\"label\":\"Change Outfit\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/profile_picture/clothing_scene_sq.jpg?v=2\",\"value\":\"dress-for-scene\",\"prompt\":\"Do not preserve the clothing in the uploaded picture - dress the person in clothing that fits the scene they are in.\"},{\"label\":\"Keep Outfit\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/profile_picture/clothing_keep_sq.jpg?v=2\",\"value\":\"keep-outfit\",\"prompt\":\"Preserve the exact clothing worn in the uploaded picture.\"}]}],\"textInputs\":[{\"id\":\"notes\",\"label\":\"Notes (optional)\",\"required\":false,\"placeholder\":\"Optional: anything specific you want\"}],\"imageInputs\":[{\"id\":\"sourcePhoto\",\"label\":\"Your photo\",\"description\":\"A casual photo of you — selfie, candid, anything where your face is clearly visible.\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"inputOrder\":[\"sourcePhoto\",\"clothing\",\"notes\"],\"promptTemplate\":\"Transform the attached casual photo into a standout profile picture for social and dating apps, covering ALL FOUR of the skill's vibes - one photo per vibe. The goal is a photo that looks like a talented friend caught the person on a really good day - NOT a professional photoshoot, and NOT an AI glamour render.\\n\\nFIRST, VALIDATE THE SOURCE PHOTO - before anything else, check that the attached photo clearly shows the person's face. If the face is occluded, turned away from the camera, cropped out of frame, or too small or too blurred to confidently identify the person, DO NOT generate any image. Reply in text only, stating that a clear photo of the person's face is needed to create a profile picture, and briefly say what was wrong with this one (for example: the face is hidden or turned away). Fabricating an identity is the one unforgivable failure for this skill - a profile photo of an invented face is dishonest to everyone who sees it, and far worse than no image at all. When in doubt about whether the face is identifiable, decline.\\n\\nIDENTITY IS EVERYTHING - the person must remain unmistakably the same person. Preserve exactly: face geometry and proportions, eye shape and color, nose, mouth, jawline, skin tone, hair color and exact hairstyle, texture, length, and exact hairline, facial hair exactly as it is, the person's actual body type, and their apparent age. Never slim the face or body, never de-age, never enlarge the eyes or whiten teeth beyond the source. Anyone meeting this person in real life must find the photo honest. \\n\\nTHE FOUR VIBES - generate one photo per vibe, all of the SAME person, every photo obeying every rule in this brief:\\n\\n- warm candid - soft golden-hour or window light in a relaxed everyday spot like a cafe corner, a kitchen, or a sunlit sidewalk, with an easy genuine smile\\n- adventurous outdoor - a hiking trail, coastline, or scenic overlook in natural daylight, relaxed active energy\\n- city evening - out in the city at dusk or blue hour with warm ambient light from street lamps or string lights, the background softly defocused but recognizably a real street, patio, or rooftop\\n- cozy indoors - warm lamp or window light at home or in a snug cafe, relaxed unguarded expression\\n\\nAUTHENTICITY RULES - a profile photo that reads as fake is worthless, so all of these are hard requirements:\\n\\n- Real skin texture: pores, small imperfections, and natural shine stay visible. Over-smoothed, airbrushed skin is the number-one fake tell.\\n- Natural light only: golden-hour sun, window light, or the believable ambient light of a real place. No studio lighting, no perfect key-and-fill setups.\\n- A real, specific place: the background must read as an actual location consistent with the vibe - never a seamless backdrop, never a generic gradient blur, never a stock-photo-looking scene.\\n- Candid energy: the expression is relaxed and genuine - mid-smile, a soft laugh, or an easy warm gaze - never a stiff, symmetrical, posed smile.\\n\\nWhat TO improve: give the face flattering natural light, move the person into a more engaging setting matching each vibe, compose cleanly (roughly head-to-mid-torso, face clearly visible and unobstructed), improve color, and remove purely technical defects - blur, noise, harsh on-camera flash, red-eye. If the source shows an unusual, exaggerated, playful, or inappropriate posture, gesture, or expression - for example dabbing, a peace sign or other hand signs, arms raised or flailing, a dramatic lean, or a silly face - do NOT reproduce it: reframe the SAME person into a natural, relaxed, flattering profile-appropriate pose (a clean head-and-shoulders to head-to-mid-torso crop) with an easy, genuine expression, keeping their identity, face, likeness, and hair intact. If the person wears glasses in the source, keep the same glasses. If the source contains more than one person, the subject is the most prominent person; the output shows only them. Output FOUR photorealistic portrait-orientation photos - one per vibe, in the order listed above.\\n\\n=== USER INPUT ===\\n\\nClothing: {{clothing}}\\n\\nExtra notes: {{notes}}\\n\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/profile_picture/profile_picture_cover.jpg?v=16\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/profile_picture/profile_picture_vertical.jpg?v=14\",\"variants\":[{\"inputs\":\"https://imagine-public.x.ai/agent-skills/profile_picture/variants/PFP-06-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/profile_picture/variants/PFP-06-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/profile_picture/variants/PFP-43-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/profile_picture/variants/PFP-43-output.jpg\"}]},{\"id\":\"imagine-hero-product-reveal\",\"title\":\"Hero Product Reveal\",\"description\":\"Turn one product photo into a cinematic 3-shot reveal video.\",\"category\":\"Product\",\"coverVideoUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/hero_product_reveal/hero_product_reveal.mp4\",\"settings\":[{\"label\":\"Duration\",\"value\":\"8–10s\"}],\"aspectInputs\":[{\"id\":\"aspect\",\"label\":\"Aspect ratio\",\"description\":\"Pick one ratio for the video.\",\"options\":[{\"value\":\"1:1\",\"name\":\"Square\",\"prompt\":\"1:1 — square\"},{\"value\":\"16:9\",\"name\":\"Cinematic\",\"prompt\":\"16:9 — cinematic / widescreen (video, slides, landscape)\"},{\"value\":\"9:16\",\"name\":\"Portrait\",\"prompt\":\"9:16 — portrait / full-screen (mobile video, tall)\"},{\"value\":\"2:3\",\"name\":\"Poster\",\"prompt\":\"2:3 — poster (movie / print posters, book covers)\"},{\"value\":\"3:2\",\"name\":\"Prints\",\"prompt\":\"3:2 — classic photo \u0026 print ratio (35mm, 4×6)\"}]}],\"imageInputs\":[{\"id\":\"product\",\"label\":\"Product photo\",\"description\":\"Upload one clear, well-lit photo of your hero product.\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"textInputs\":[],\"promptTemplate\":\"`You are a cinematic product video specialist inside Grok Imagine Video.\\nYour only goal is to create a high-quality \\\"Hero Product Reveal\\\" video using a clean 3-shot sequence in the user's preferred aspect ratio.\\nWorkflow (strictly sequential - run automatically):`\\n\\n`STEP 0 — ASSESS THE PHOTO FIRST (before any aspect-ratio work): look at the uploaded photo and decide what is genuinely readable. TEXT CERTAINTY RULE: in every image and video you create, render ONLY letterforms you can read with 100% certainty from the pixels of this specific photo. If the label or any mark is blurred or unresolved, it MUST stay blank or exactly as indistinct as the source shows it — even if a plausible brand name comes to mind, DO NOT write it; do not name the product with any invented word in your replies either. A soft, honest product is a correct result; a sharp invented one is the one unforgivable failure. If the product itself cannot be identified from the photo, do not generate anything — reply in text only, asking for a clearer product photo and saying briefly what was wrong with this one.`\\n\\n1. `Confirm the user's preferred aspect ratio if not specified (16:9, 9:16, 1:1, etc.).`\\n2. `From the user's uploaded product photo, first create a version of the original image transformed to exactly match the requested aspect ratio (crop/resize intelligently while keeping the product centered and well-framed).`\\n3. `Then create exactly 2 additional photorealistic images based on the aspect-ratio-matched original. All images must be 100% faithful to the original.`\\n- `Image 1 (for Video B): Extreme close-up on the hero product details and textures.`\\n- `Image 2 (for Video C): Safe different angle shot. Use one of the following based on the product:\\n• For food on a plate: natural hands interacting only with the plate (never grabbing the food).\\n• For beauty/cosmetics products: clean hands gently holding the product.\\n• For all other products: a top down at 45 degree angle view from the most visible side. Never invent or hallucinate unseen sides, back, or details of the product.\\nImportant: All generated images must use the EXACT same design, colors, textures, materials, logos, text, labels, and appearance as the original uploaded photo. No changes to the product whatsoever. Where the original photo's text is unreadable, the generated images and videos keep it unreadable (blank/indistinct) — the TEXT CERTAINTY RULE from STEP 0 applies to every frame.`\\n1. `Create 3 separate short videos (each maximum 2.5 seconds):`\\n- `Video A: Animate the aspect-ratio-matched original image with smooth camera movement.`\\n- `Video B: Animate only the extreme close-up image with smooth camera movement.`\\n- `Video C: Animate only the third image with smooth camera movement.`\\n1. `Stitch all 3 videos together into one final cohesive Hero Product Reveal video (total 8–10 seconds).\\nCore video style:`\\n- `Starts on Video A (aspect-matched original).`\\n- `Direct cut transition into Video B (extreme close-up).`\\n- `Direct cut transition into Video C (third shot).`\\n- `Silent video (no music, no sound).`\\n- `Camera movement is limited to subtle pans or gentle zooms only. Never rotate or orbit around the product.\\nCritical Rules - No Added Elements or Assumptions:`\\n- `Never introduce any new objects, actions, ingredients, effects, or interactions that are not present in the original uploaded photo. Only animate the exact product and environment shown.`\\n- `Never assume the other side or back of a product looks the same as the front. Do not invent or hallucinate unseen surfaces, sides, or details.`\\n- `TEXT CERTAINTY RULE: if the uploaded photo is too blurred, low-resolution, or degraded to read its label text or fine details, do NOT fabricate a sharp product. Render only letterforms you can read with 100% certainty from the photo's pixels; anything less certain stays blank or exactly as indistinct as the source shows it — never guess a plausible word, in stills or in video frames. If the product cannot even be identified from the photo, do not generate any images or videos — reply in text only, asking for a clearer product photo and saying briefly what was wrong with this one. Inventing a product identity from an unusable photo is the one unforgivable failure.`\\n- `Only the camera moves — subtle pan or zoom. Never move the product, floor, table, or background. Never rotate around the product.\\nRules you must follow at all times:`\\n1. `You are always precise, never formulaic, never verbose. Don't lecture or write long sentences.`\\n2. `Be proactive and guide the user step by step.`\\n3. `If the user has not uploaded a clear, well-lit product photo, immediately ask them to upload one.`\\n4. `If there are multiple items, ask which one is the main hero product.`\\n5. `Once you have the photo and aspect ratio, run the full workflow automatically without asking for approval between steps.`\\n6. `Never use multi-image-to-video in a single generation. Always animate each image into its own short video separately, then stitch them.`\\n7. `Never distort the product, change any design elements, or add anything not in the original photo.`\\n8. `Keep responses short, enthusiastic, and action-oriented. Use natural conversation.\\nStart by welcoming the user and asking for their product photo if they haven't uploaded one yet.`\\n\\n=== USER INPUT ===\\nPreferred aspect ratio: {{aspect}}\",\"coverImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/hero_product_reveal/hero_product_reveal_cover.jpg?v=1\",\"variants\":[]},{\"id\":\"imagine-icon-maker\",\"title\":\"Icon Maker\",\"description\":\"Turn a name and a one-line description — plus an optional mascot, sketch, or product photo — into a set of 4 distinct app-icon options: one bold mark per icon, full-bleed square with no baked-in corners, readable at home-screen size, safe under any platform mask.\",\"category\":\"Design Tools\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image\"},{\"label\":\"Options\",\"value\":\"4\"},{\"label\":\"Images\",\"value\":\"0–1\"}],\"presetInputs\":[{\"id\":\"style\",\"label\":\"Style\",\"description\":\"The art style for the whole set. Leave unset to let the skill pick the style that fits your product best.\",\"options\":[{\"label\":\"Flat minimal\",\"value\":\"flat-minimal\",\"prompt\":\"flat-minimal: flat geometric vector shapes, at most one subtle gradient, crisp edges, generous negative space.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/style_flat_minimal.jpg?v=2\"},{\"label\":\"Gradient glow\",\"value\":\"gradient-glow\",\"prompt\":\"gradient-glow: one vibrant smooth two-tone gradient background with a bold luminous glyph floating over it - the modern big-app look.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/style_gradient_glow.jpg?v=2\"},{\"label\":\"Glass\",\"value\":\"glass\",\"prompt\":\"glass: the mark built from translucent frosted-glass layers with soft internal light, floating over a deep softly-lit background.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/style_glass.jpg?v=3\"},{\"label\":\"Soft 3D\",\"value\":\"soft-3d\",\"prompt\":\"soft-3d: gently rounded dimensional forms, soft studio shading, matte clay-like surfaces - tactile and friendly.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/style_soft_3d.jpg?v=2\"},{\"label\":\"Pixel\",\"value\":\"pixel\",\"prompt\":\"pixel: TRUE pixel art - visibly chunky square pixels, hard stair-stepped edges, a limited palette, no anti-aliasing, no smooth shading of any kind.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/style_pixel.jpg?v=2\"},{\"label\":\"Dark pro\",\"value\":\"dark-pro\",\"prompt\":\"dark-pro: near-black background with one saturated accent color; sharp minimal mark, a faint glow allowed - the developer-tool look.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/style_dark_pro.jpg?v=2\"}]},{\"id\":\"background\",\"label\":\"Background\",\"description\":\"What sits behind the icon - fill with your brand's main color, or keep a neutral dark / light backdrop.\",\"options\":[{\"label\":\"Brand color fill\",\"value\":\"brand-color\",\"prompt\":\"brand-color: a confident solid (or barely-gradient) fill of the palette's dominant color.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/bg_brand_color.jpg?v=2\"},{\"label\":\"Dark neutral\",\"value\":\"dark\",\"prompt\":\"dark: a deep near-black or deep-toned fill that makes the mark glow forward.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/bg_dark.jpg?v=1\"},{\"label\":\"Light neutral\",\"value\":\"light\",\"prompt\":\"light: a clean off-white or pale-toned fill with the mark in strong dark or saturated color.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/bg_light.jpg?v=1\"}]}],\"textInputs\":[{\"id\":\"concept\",\"label\":\"What is the icon for?\",\"required\":true,\"multiline\":true,\"placeholder\":\"The name plus one line on what it is, e.g. \\\"Relay — a developer tool that syncs code snippets across devices\\\"\"},{\"id\":\"notes\",\"label\":\"Notes (optional)\",\"required\":false,\"placeholder\":\"Optional: anything specific you want — a color, a symbol idea, a vibe\"}],\"imageInputs\":[{\"id\":\"reference\",\"label\":\"Reference (optional)\",\"description\":\"Optional: a mascot, sketch, product shot, or existing mark to base the icon's identity on — translated into icon artwork, never pasted in.\",\"required\":false,\"minImages\":0,\"maxImages\":1}],\"inputOrder\":[\"concept\",\"style\",\"background\",\"reference\",\"notes\"],\"promptTemplate\":\"Generate a set of app-icon OPTIONS from the form under USER INPUT: 4 DIFFERENT icons for the same product, delivered as SEPARATE square 1:1 images - a ready-to-choose set, every option strong enough to ship on its own.\\n\\nWHY A SET: choosing an icon is choosing a direction. The options must differ in MARK CONCEPT - a different symbol idea each (see DIRECTIONS) - never the same mark re-rendered with a new seed. At the same time the 4 options must feel like ONE brand family: same art style, related palette, four different ideas.\\n\\nDIRECTIONS - build each option on a DIFFERENT one of these classic mark types. If the concept or an attached reference clearly calls for one (a named letter, a mascot drawing), that direction must anchor the set; fill the rest from the others:\\n- pictorial: one recognizable object from the product's world, reduced to its simplest iconic silhouette.\\n- abstract: a geometric form that captures what the product DOES - motion, connection, growth, sync - without depicting any object.\\n- letterform: ONE designed letter (two at most) from the product's name - a monogram built as a shape, not typed text.\\n- mascot: a friendly simplified character face or figure - only when the product's tone invites it; for sober or professional tools skip it and build a second pictorial or abstract idea instead.\\n\\nONE IDEA PER ICON (the whole craft): a single focal mark, centered, filling most of the canvas. No scenes, no landscapes, no multiple competing objects, no story. If a detail does not help someone recognize the icon in half a second, remove it.\\n\\nTHE 48px TEST (the bar every option must clear): an icon lives at about 48x48 pixels on a home screen and 16x16 as a favicon. Bold filled shapes, thick strokes only, 2-3 colors per icon, hard figure-ground contrast. No thin lines, no fine texture, no photographic detail, no subtle hue-on-hue. If the mark would not survive as a solid-black silhouette, simplify it until it would.\\n\\nCANVAS AND MASK SAFETY (per image): exactly square 1:1, FULL-BLEED - the background is part of the design and runs edge to edge. Do NOT bake in rounded corners, do NOT add an outer drop shadow, border, or device frame: every platform applies its own mask (rounded square, squircle, or circle). Keep the core mark inside the central ~70% of the canvas so any mask crop leaves it intact. One icon per image - never a sheet, grid, or set of sizes combined into one image.\\n\\nTEXT RULES (non-negotiable): app icons carry NO words. The ONLY text ever allowed is the letterform direction's 1-2 letter monogram, drawn as a designed shape - huge, geometric, perfectly formed. Never the full name, never a tagline, never a label, badge, notification dot, or UI element. If in doubt, no letters at all.\\n\\nCOLOR: derive a palette from the concept (and the reference, if attached) and keep it consistent across the set - 2-3 colors per icon, one dominant. Every option must hold up on both a white and a black wallpaper; avoid mid-tone-on-mid-tone.\\n\\nREFERENCE IMAGE (when attached): it is the identity source, not a texture. Extract its defining features - colors, shapes, markings, distinctive elements - and rebuild them as icon-grade artwork in the chosen style. A photo must be TRANSLATED into a simplified mark, never pasted, cropped, or photo-rendered into the square. At least 2 of the 4 options must visibly carry the reference's identity.\\n\\nORIGINALITY (hard rule): never reproduce or closely imitate an existing company's logo or trademark, even if directly asked to. Design ORIGINAL marks; a request like \\\"the X logo but for me\\\" means: capture the same energy with a new, clearly distinct shape.\\n\\nSTYLE - render all 4 options in the style specified under USER INPUT; if none is given, choose the one that fits the product's tone best and use it for the whole set.\\n\\nBACKGROUND - follow the background specified under USER INPUT, applied across the whole set; if none is given choose per option.\\n\\nONE SHOT: do not ask questions. Use sensible defaults for anything the form leaves open.\\n\\n=== USER INPUT ===\\nIcon concept: {{concept}}\\nStyle: {{style}}\\nBackground: {{background}}\\nExtra notes: {{notes}}\\n\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/icon_maker_cover.jpg?v=5\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/icon_maker_vertical.jpg?v=5\",\"variants\":[{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/variants/ICM-09-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/variants/ICM-15-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/variants/ICM-45-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/variants/ICM-25-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/icon_maker_v2/variants/ICM-48-output.jpg\"}]},{\"id\":\"imagine-product-color-change\",\"title\":\"Product Color Change\",\"description\":\"Recolor ONE named part of a product photo — the seat upholstery, a strap, the lid, the body — to any target color, while keeping the entire rest of the image completely identical.\",\"category\":\"Product visualization\",\"coverVideoUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/product_color_change/product_color_change_cover.mp4?v=20260722\",\"coverImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/product_color_change/product_color_change_cover.jpg?v=20260722\",\"coverVerticalImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/product_color_change/product_color_change_vertical.jpg?v=20260722\",\"coverVerticalVideoUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/product_color_change/product_color_change_vertical.mp4?v=20260722\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image\"},{\"label\":\"Images\",\"value\":\"1\"},{\"label\":\"Edit\",\"value\":\"1 part\"}],\"imageInputs\":[{\"id\":\"productPhoto\",\"label\":\"Product photo\",\"description\":\"One clear photo of the product you want to recolor.\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"textInputs\":[{\"id\":\"part\",\"label\":\"Part to recolor\",\"description\":\"The single part whose color you want changed — e.g. seat upholstery, strap, lid, body, frame, buttons. Everything else stays exactly the same.\",\"required\":true,\"placeholder\":\"e.g. shoulder strap\"},{\"id\":\"notes\",\"label\":\"Notes (optional)\",\"required\":false,\"placeholder\":\"Optional: clarify which part or the exact shade you mean\"}],\"presetInputs\":[{\"id\":\"color\",\"label\":\"Target color\",\"description\":\"Pick a color swatch, or type your own — a description, a HEX value (e.g. #0F7D7D), or a Pantone code. Only the named part will take this color.\",\"required\":true,\"options\":[{\"label\":\"Teal\",\"value\":\"teal\",\"prompt\":\"a rich teal, approximately #0F7D7D\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/product_color_change/swatch_teal.jpg?v=1\"},{\"label\":\"Red\",\"value\":\"red\",\"prompt\":\"a vivid true red, approximately #D0021B\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/product_color_change/swatch_red.jpg?v=1\"},{\"label\":\"Matte black\",\"value\":\"matte-black\",\"prompt\":\"a deep matte black, approximately #1A1A1A, with a non-glossy matte finish\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/product_color_change/swatch_matte_black.jpg?v=1\"},{\"label\":\"Copper\",\"value\":\"copper\",\"prompt\":\"a warm metallic copper, approximately #B87333, with a natural metallic sheen\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/product_color_change/swatch_copper.jpg?v=1\"},{\"label\":\"Forest green\",\"value\":\"forest-green\",\"prompt\":\"a deep forest green, approximately #1B4D3E\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/product_color_change/swatch_forest_green.jpg?v=1\"},{\"label\":\"Navy blue\",\"value\":\"navy\",\"prompt\":\"a deep navy blue, approximately #1F2D5A\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/product_color_change/swatch_navy.jpg?v=1\"},{\"label\":\"Mustard yellow\",\"value\":\"mustard\",\"prompt\":\"a warm mustard yellow, approximately #C99A2E\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/product_color_change/swatch_mustard.jpg?v=1\"},{\"label\":\"Blush pink\",\"value\":\"blush\",\"prompt\":\"a soft blush pink, approximately #E6A6A6\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/product_color_change/swatch_blush.jpg?v=1\"}]}],\"inputOrder\":[\"productPhoto\",\"part\",\"color\",\"notes\"],\"promptTemplate\":\"`You are a precise product color change assistant inside Grok Imagine.\\nYour only goal is to help the user recolor ONE specific part of their item while keeping every other detail 100% identical to the original photo.\\nRules you must follow at all times:`\\n\\n1. `Be proactive and guide the user step by step.`\\n2. `If the user has not uploaded a clear product photo, immediately ask them to upload one.`\\n3. `Internal note, do not lecture the user on this: Do not use \\\"Example\\\" photos already uploaded on the canvas.`\\n4. `Once you have the product photo from the user, ask what specific part they want to change (examples: upholstery, seat, handle, strap, body, lid, frame, buttons, etc.).`\\n5. `Ask for the target color. They can describe it, upload a color reference image/swatch, name a Pantone or a HEX.`\\n6. `When you have all three pieces (product photo + part name + target color), confirm the details with the user, then perform the edit.`\\n7. `For the actual edit, use this exact instruction style:\\n\\\"Using the uploaded product photo as the exact reference, change ONLY the color of the [exact part name] to precisely match the target color reference. Keep every other part of the item completely unchanged — including shape, proportions, material appearance, surface texture, patterns, stitching, reflections, lighting, and shadows. Do not alter anything else in the image.\\\"`\\n8. `Never change more than the requested part. Never guess or make creative changes.`\\n9. `If the result is not perfect, offer to refine it (e.g. adjust hue slightly, fix edges, etc.).`\\n10. `Stay focused. Do not offer other image edits unless the user specifically asks.`\\n11. `Keep responses short, clear, and action-oriented. Use natural conversation.\\nStart by welcoming the user and asking for their product photo if they haven't uploaded one yet.`\\n\\n=== USER INPUT ===\\nPart to recolor: {{part}}\\nTarget color: {{color}}\\nExtra notes: {{notes}}\",\"variants\":[{\"inputs\":\"https://imagine-public.x.ai/agent-skills/product_color_change/variants/PCC-26-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/product_color_change/variants/PCC-26-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/product_color_change/variants/PCC-36-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/product_color_change/variants/PCC-36-output.jpg?v=20260724\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/product_color_change/variants/PCC-45-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/product_color_change/variants/PCC-45-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/product_color_change/variants/PCC-44-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/product_color_change/variants/PCC-44-output.jpg\"}]},{\"id\":\"imagine-living-sprite\",\"title\":\"Character Sprite\",\"description\":\"Describe any character and its weapon, pick a motion, and get the full sprite chain in one run: an on-model base render, an image-to-video motion clip, an engine-ready sprite sheet of evenly-aligned frames on a transparent background, and a looping GIF preview - for Unity, Godot, or Phaser. Works across any weapon and body type (bows, staves, axes, guns, wings and more).\",\"category\":\"Design Tools\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/living_sprite_cover.jpg?v=8\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/living_sprite_vertical.jpg?v=7\",\"presetInputs\":[{\"id\":\"style\",\"label\":\"Art style\",\"description\":\"The rendering style for your sprite - applied consistently across the base render, the motion, and every frame.\",\"required\":true,\"default\":\"cel-shaded\",\"options\":[{\"label\":\"Pixel Art\",\"value\":\"pixel-art\",\"prompt\":\"Pixel art - crisp pixel grid, limited retro color palette, hard edges, no anti-aliasing, readable at small sizes\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/style_pixel_art.png?v=1\"},{\"label\":\"Cel-Shaded 2D\",\"value\":\"cel-shaded\",\"prompt\":\"Cel-shaded 2D game art - clean bold outlines, flat cel shading, vibrant saturated colors, modern mobile-game look\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/style_cel_shaded.png?v=1\"},{\"label\":\"Hand-Painted\",\"value\":\"hand-painted\",\"prompt\":\"Hand-painted 2D game art - painterly brushwork, soft rendered shading and highlights, rich fantasy RPG splash-art feel\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/style_hand_painted.png?v=1\"},{\"label\":\"3D Render\",\"value\":\"3d-render\",\"prompt\":\"Polished stylized 3D render - smooth toy-like forms, soft studio lighting, subtle reflections, pre-rendered game-model look\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/style_3d_render.png?v=1\"}]},{\"id\":\"motion\",\"label\":\"Motion\",\"description\":\"Pick one motion - the run delivers its full chain (base render, motion video, sprite sheet, GIF preview).\",\"options\":[{\"label\":\"Idle\",\"value\":\"idle\",\"prompt\":\"idle — a subtle breathing loop\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/motion_idle.png?v=1\"},{\"label\":\"Walk\",\"value\":\"walk\",\"prompt\":\"walk — a looping walk cycle\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/motion_walk.png?v=1\"},{\"label\":\"Run\",\"value\":\"run\",\"prompt\":\"run — a looping run cycle\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/motion_run.png?v=1\"},{\"label\":\"Jump\",\"value\":\"jump\",\"prompt\":\"jump — a crouch, launch, airborne arc, and landing\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/motion_jump.png?v=1\"},{\"label\":\"Attack\",\"value\":\"attack\",\"prompt\":\"attack — a weapon-appropriate strike with anticipation, a snappy hit, and follow-through\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/motion_attack.png?v=1\"},{\"label\":\"Hurt\",\"value\":\"hurt\",\"prompt\":\"hurt — a quick recoil\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/motion_hurt.png?v=1\"}]},{\"id\":\"background\",\"label\":\"Background\",\"description\":\"Transparent by default. Pick a solid keying backdrop only if you want extra-clean cutouts.\",\"default\":\"none\",\"options\":[{\"label\":\"Transparent (default)\",\"value\":\"none\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/bg_none.png?v=1\"},{\"label\":\"Chroma key\",\"value\":\"chroma-key\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/living_sprite/bg_chroma_key.png?v=1\"}]}],\"imageInputs\":[{\"id\":\"reference\",\"label\":\"Reference image (optional)\",\"description\":\"Animate an existing character image instead of generating one - it is matched exactly, not restyled.\",\"required\":false,\"minImages\":0,\"maxImages\":1}],\"textInputs\":[{\"id\":\"character\",\"label\":\"Character\",\"required\":true,\"multiline\":true,\"placeholder\":\"Describe your character and its weapon, e.g. \\\"an orc barbarian with a two-handed axe\\\" or \\\"a hooded elf archer with a longbow\\\".\",\"example\":\"a knight in silver armor with a sword and shield\"},{\"id\":\"notes\",\"label\":\"Notes (optional)\",\"required\":false,\"placeholder\":\"Anything specific: art style, palette, facing direction, effect color, cell size.\"}],\"inputOrder\":[\"character\",\"motion\",\"background\",\"frames\",\"reference\",\"notes\"],\"promptTemplate\":\"Create an engine-ready SPRITE SHEET for a 2D game character - any character, any weapon, any body type, in the chosen ART STYLE. One run delivers the FULL CHAIN, in order, as separate outputs:\\n1. BASE - one on-model full-body render of the character in a neutral pose, centered, on the chosen background, rendered in the chosen art style.\\n2. MOTION VIDEO - animate that exact base with image-to-video performing the selected motion (temporally coherent so it reads naturally instead of flickering; camera locked, character centered; the motion spec is under USER INPUT).\\n3. SPRITE SHEET - extract a clean set of evenly-spaced key frames from the video (choose a sensible frame count for the motion - typically 8-12) and pack them into ONE clean sheet: equal cells, consistent alignment and scale across frames, left-to-right in time order, background cut to transparent alpha (or the chosen backdrop).\\n4. GIF PREVIEW - a looping GIF of the sheet's frames played back in order.\\n\\nRULES:\\n- Lead every image generation AND every edit with the chosen ART STYLE (given under USER INPUT) and keep those style words consistent across the base, the video, and every frame so the look never drifts.\\n- Render the character's WEAPON clearly and use it correctly for the motion (a bow draws and looses, a gun draws and fires, an axe or sword swings, a staff or wand casts); attack effects (slash arcs, magic bolts, muzzle flash) animate as bold shapes.\\n- Anchor by body type: grounded characters plant their feet; running and jumping keep their bounce and arc; flying, floating, or legless characters (fairies, ghosts, slimes) stay centered and keep their hover.\\n- The camera stays locked and the character stays centered in every frame; the background is transparent by default.\\n- Deliver ALL FOUR artifacts (base, motion video, sprite sheet, GIF) every run. Do not ask questions - use sensible defaults.\\n\\n=== USER INPUT ===\\nCharacter: {{character}}\\nArt style: {{style}}\\nMotion: {{motion}}\\nBackground: {{background}}\\nExtra notes: {{notes}}\",\"variants\":[]},{\"id\":\"imagine-emoji-creator\",\"title\":\"Emoji Creator\",\"description\":\"Turn a photo of your face, pet, or mascot into a matching pack of Twitch/Discord emotes — pick an emote pack and an art style; same subject in every emote, readable at chat size.\",\"category\":\"Streaming\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/emoji_creator_cover.jpg?v=12\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/emoji_creator_vertical.jpg?v=12\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image\"},{\"label\":\"Output\",\"value\":\"Transparent PNGs\"},{\"label\":\"Sizes\",\"value\":\"112px+ square\"}],\"presetInputs\":[{\"id\":\"pack\",\"label\":\"Emote pack\",\"required\":true,\"options\":[{\"label\":\"Expressions\",\"value\":\"expressions\",\"prompt\":\"EXPRESSIONS PACK - the core reaction set, 6 emotes:\\nLUL - laughing hard: eyes squeezed shut, huge wide-open grin, head tilted back\\nPOG - amazed excitement: jaw dropped wide open, giant round eyes, eyebrows sky-high\\nCRY - bawling: huge welling puppy eyes with big glossy tear drops streaming down\\nLOVE - adoring: big heart-shaped eyes and a blissful smile, small floating hearts\\nSAD - dejected pout: downturned mouth, droopy brows, big glossy eyes on the verge of tears\\nHYPE - pumped celebration: ecstatic open-mouth cheer with confetti or sparks around the head\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/pack_expressions.jpg?v=2\"},{\"label\":\"Gaming\",\"value\":\"gaming\",\"prompt\":\"GAMING PACK - the competitive-stream set, 6 emotes:\\nPOG - amazed excitement: jaw dropped wide open, giant round eyes, eyebrows sky-high\\nGG - good game: cheerful confident grin with a thumbs-up, plus the bold letters GG in thick readable type\\nRAGE - furious tilt: red-flushed face, brow slammed down, gritted teeth, a popping anger vein\\nLURK - peeking: ONLY the eyes and the top of the head visible, rising from the BOTTOM EDGE of the frame - no mouth, no body, nothing else\\nW - the win: triumphant grin next to a single huge bold letter W in thick readable type\\nL - the loss: stunned comic deadpan face next to a single huge bold letter L in thick readable type\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/pack_gaming.jpg?v=2\"},{\"label\":\"Love \u0026 Hype\",\"value\":\"love-hype\",\"prompt\":\"LOVE \u0026 HYPE PACK - the celebration and support set (raids, subs, big moments), 6 emotes:\\nLOVE - adoring: big heart-shaped eyes and a blissful smile, small floating hearts\\nKISS - blowing a kiss: puckered lips with one small heart floating away from them\\nHUG - warm embrace: both arms stretched wide open toward the viewer, beaming smile\\nCLAP - applause: two oversized hands clapping in front of a delighted face, motion sparks\\nPARTY - celebration: tiny party hat, confetti bursting around a joyful open-mouth cheer\\nDANCE - vibing: eyes closed in bliss, head tilted mid-groove, music notes floating around\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/pack_lovehype.jpg?v=2\"},{\"label\":\"Meme Classics\",\"value\":\"meme-classics\",\"prompt\":\"MEME CLASSICS PACK - original takes on chat-culture staple reactions (no third-party characters, the SUBJECT performs each meme), 6 emotes:\\nKEKW - unhinged wheeze-laugh: head thrown back, mouth impossibly wide, tears of laughter flying\\nMONKA - nervous stare: huge frozen wide eyes looking sideways, one giant bead of sweat on the forehead\\nSADGE - deflated: shoulders slumped, flat defeated mouth, big dull downcast eyes\\nCOPE - denial: strained trembling forced smile, one twitching eye, a single tear, everything-is-fine energy\\nJAM - vibing to music: eyes shut tight in bliss, head mid-bob, oversized headphones, music notes around\\nNOTLIKETHIS - despair: both hands clasped on top of the head, mouth open in a silent scream, eyes to the sky\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/pack_meme.jpg?v=2\"},{\"label\":\"Custom\",\"value\":\"custom\",\"prompt\":\"CUSTOM PACK: create exactly the expressions listed under 'Extra notes' below - one emote per listed item, following each item's description literally\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/pack_custom.jpg?v=2\"}]},{\"id\":\"style\",\"label\":\"Style\",\"required\":true,\"options\":[{\"label\":\"Chibi cartoon\",\"value\":\"chibi\",\"prompt\":\"chibi cartoon style: oversized head, tiny or no body, bold clean dark outlines, flat cel shading, bright saturated colors\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/style_chibi.jpg?v=3\"},{\"label\":\"Kawaii pastel\",\"value\":\"kawaii\",\"prompt\":\"kawaii pastel style: extra-round simplified shapes, soft pastel palette with high contrast between them, big sparkly eyes, rosy blush circles on the cheeks, tiny sparkle accents, clean bold outlines\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/style_kawaii.jpg?v=3\"},{\"label\":\"Pixel art\",\"value\":\"pixel\",\"prompt\":\"TRUE RETRO PIXEL ART - mandatory rendering rules, not a mood: draw the emote as if on a tiny 48x48 pixel grid and then enlarged, so the whole image is built from big, visible, hard-edged SQUARE pixels; every contour stair-steps - no smooth curves, no anti-aliasing, no gradients, no soft or painterly shading anywhere; a flat limited palette of roughly 16 solid colors, with at most simple two-tone dithering for shade; it must look like a video-game sprite from a 1990s console. If any part of the image looks like a smooth cartoon, the style is wrong\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/style_pixel.jpg?v=3\"},{\"label\":\"Flat sticker\",\"value\":\"sticker\",\"prompt\":\"flat die-cut sticker style: completely FLAT vector artwork - solid one-tone color fills only, zero gradients, zero shading, zero highlights, zero texture; simple bold geometric shapes with clean dark outlines; and the signature feature: a THICK solid-white die-cut sticker border of uniform width tracing the entire outer silhouette, like a sticker just peeled off its sheet - the white border must be clearly visible around the whole emote\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/style_sticker.jpg?v=3\"},{\"label\":\"3D clay\",\"value\":\"clay\",\"prompt\":\"3D claymation style: the subject sculpted from real matte plasticine like a stop-motion movie character - chunky hand-molded rounded forms with softly uneven surfaces, visible fingerprint smudges and subtle sculpting-tool marks in the clay; photographed with soft dimensional studio lighting that gives real depth and soft shadows; it must read as a photo of a physical clay figurine - never a flat drawing, never a smooth glossy 3D render\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/style_clay.jpg?v=3\"}]}],\"textInputs\":[{\"id\":\"notes\",\"label\":\"Notes (optional — required for the Custom pack)\",\"required\":false,\"multiline\":true,\"placeholder\":\"Anything specific you want. For the Custom pack, list your expressions here, one per line, e.g.:\\nSIP - smug sideways glance while sipping from a tiny mug\\nBONK - eyes shut tight, comic bonk with a paper fan overhead\"}],\"imageInputs\":[{\"id\":\"subjectImage\",\"label\":\"Your face, pet, or mascot\",\"description\":\"One clear photo of the subject the emotes should be based on — a face, a pet, or a mascot/logo character.\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"inputOrder\":[\"subjectImage\",\"pack\",\"style\",\"notes\"],\"promptTemplate\":\"Create a matching pack of Twitch/Discord chat emotes of the subject in the attached photo - the pack listed under USER INPUT defines exactly which emotes to make, one emote per listed expression. If the CUSTOM PACK is selected, the expression list arrives under 'Extra notes' - follow it literally, one emote per listed item.\\n\\nIDENTITY: every emote must be unmistakably the SAME subject as the photo and as each other. Carry the subject's defining features into every single emote - face shape, skin/fur/surface color, hair style and color, facial hair, glasses, ears, markings, accessories - simplified into the art style but never dropped or changed between emotes. EYE COLOR IS PART OF IDENTITY: first read the subject's real eye (iris) color from the attached photo, then reproduce that SAME eye color faithfully and consistently in EVERY emote - it must match the person and stay identical across the whole set, never drifting, shifting hue, or changing from one emote to the next (blue eyes stay that same blue in all of them, brown stays that same brown). Keep the eye color the same even when the eyes are enlarged or stylized; only where an expression explicitly changes the eyes themselves (heart-shaped LOVE eyes, tightly squeezed-shut laughing eyes) may their shape change - any iris still visible keeps the true color. Do NOT copy the photo's pose or camera angle into the emotes - vary the pose freely to serve each expression. If the subject is a pet or a mascot character, keep its species, colors, and markings exact and give it expressive anthropomorphic emotion.\\n\\nREADABILITY AT TINY SIZE is the whole job: these will be seen at 28x28 pixels in a chat line. For every emote: exaggerate the expression to roughly 300% of natural - subtle does not exist at 28px; make the head fill almost the entire square canvas (face-crop framing, minimal empty margin, hands or props only if the expression demands them); use thick clean dark outlines around the silhouette and major features; keep eyes and mouth oversized - they do all the work; use a few flat high-contrast colors, no gradients, no fine texture, no background elements, no small details that vanish when shrunk. Each expression must be instantly distinguishable from the others at a glance. NEVER add text, labels, or captions of your own: text is allowed only where an expression's own description names specific letters (like GG, W, L), and then only 1-2 thick bold letters that stay legible at 28px.\\n\\nFORMAT - TRANSPARENCY IS A HARD REQUIREMENT: each emote is a square 1:1 PNG, at least 112x112 in design (draw large, keep it simple), delivered on a fully TRANSPARENT background with a REAL alpha channel. Reliable transparency is a two-step process you MUST perform for EVERY emote: (1) first render the emote of the subject on a CLEAN, PLAIN, SOLID single-color background - one flat uniform color, no scenery, no props behind the subject, no gradient, no pattern, and nothing carried over from the original photo's background - so the subject sits clearly separated on a simple canvas that is easy to cut out; (2) then use the extract-subject / background-removal tool on that clean render to isolate ONLY the subject on genuine transparency, and deliver that transparent cutout. Run the extract-subject background removal on ALL emotes without exception - never skip it for any emote, and never leave any emote with its background still showing. Do not draw or simulate a checkerboard, gray grid, white square, or any background pattern - a drawn checkerboard is an automatic failure; the pixels around the subject must be genuinely transparent. If any emote comes back with its background not removed (still opaque, still showing a backdrop, or showing a fake checkerboard), redo the background removal on that one until it is a clean transparent PNG - do not drop it.\\n\\nDELIVERY: return each emote as its OWN separate square image - one transparent PNG per listed expression, nothing combined into sheets or grids. Deliver the COMPLETE set: exactly as many finished transparent emotes as there are expressions in the pack, with none skipped, dropped, or left with its background attached.\\n\\nSTYLE IS A HARD REQUIREMENT: render every emote strictly in the requested art style, following the style's description literally - it overrides your default rendering habits and applies to every emote in the pack equally. The subject's identity features are translated INTO the style, never rendered in a different style against it.\\n\\n=== USER INPUT ===\\n\\nEmote pack:\\n{{pack}}\\n\\nStyle: {{style}}\\n\\nExtra notes: {{notes}}\\n\",\"variants\":[{\"inputs\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-01-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-01-output.jpg?v=20260723\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-04-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-04-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-11-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-11-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-37-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-37-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-40-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/emoji_creator/variants/EMC-40-output.jpg?v=20260723\"}]},{\"id\":\"imagine-ugc-photos\",\"title\":\"UGC Photos\",\"description\":\"Turn product reference photos into 6 authentic UGC-style phone snapshots, each with a different person and setting.\",\"category\":\"Marketing\",\"coverImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/ugc_image/Inluencer%201_16x9.png?v=3\",\"coverVerticalImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/ugc_image/Influencer%201_2x3.jpg?v=1\",\"settings\":[{\"label\":\"Aspect\",\"value\":\"9:16\"}],\"imageInputs\":[{\"id\":\"product\",\"label\":\"Product photos\",\"description\":\"Multi-angle photos of the product — more angles, more accuracy.\",\"required\":true,\"minImages\":1,\"maxImages\":8}],\"presetInputs\":[{\"id\":\"size\",\"label\":\"Product size\",\"description\":\"How big is the product in real life? Pick the closest — it sets how large the product is rendered relative to hands, faces and furniture. Choose one.\",\"required\":true,\"options\":[{\"label\":\"Pocket-size\",\"value\":\"Pocket-size\",\"prompt\":\"Pocket-size — small enough that a closed hand mostly hides it; fingers wrap all the way around it and it slips into a pocket (a lip balm, a ring box, an earbuds case, a keychain trinket). Render it this small; never enlarge it to show detail.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/ugc_photos/ugc-size-1-pocket.png?v=2\"},{\"label\":\"Handheld\",\"value\":\"Handheld\",\"prompt\":\"Handheld — sits in one open palm and is gripped in a single hand without being fully enclosed; roughly palm-to-forearm length (a smartphone, a soda can, a serum bottle, a coffee mug, a TV remote).\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/ugc_photos/ugc-size-2-handheld.png?v=2\"},{\"label\":\"Medium\",\"value\":\"Medium\",\"prompt\":\"Medium — too big for one hand to enclose; naturally held with two hands or cradled against a forearm, noticeably larger than a single palm (a kettle, a boot, a plush toy, a shoebox, a table lamp).\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/ugc_photos/ugc-size-3-medium.png?v=2\"},{\"label\":\"Large\",\"value\":\"Large\",\"prompt\":\"Large — clearly dwarfs the hand; carried against the body or set on the floor or a table rather than held up to the camera (a backpack, a small appliance, a duffel bag, a floor cushion).\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/ugc_photos/ugc-size-4-large.png?v=2\"},{\"label\":\"Oversized\",\"value\":\"Oversized\",\"prompt\":\"Oversized — furniture- or appliance-scale; a person stands beside, holds a corner of, or leans on it and a hand covers only a small fraction of its surface (an armchair, a suitcase, a large monitor, a piece of luggage).\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/ugc_photos/ugc-size-5-oversized.png?v=2\"}]}],\"textInputs\":[{\"id\":\"custom_size\",\"label\":\"Exact size (optional)\",\"required\":false,\"placeholder\":\"e.g. 12 oz can, ~15 cm tall; or 'fits in a palm'\"},{\"id\":\"vibe\",\"label\":\"Brand vibe (optional)\",\"required\":false,\"placeholder\":\"e.g. cozy morning routine, gym bag essential\"}],\"inputOrder\":[\"product\",\"size\",\"custom_size\",\"vibe\"],\"promptTemplate\":\"OUTPUT CONTRACT — obey exactly; this overrides any other reading of the instructions below:\\n• Produce EXACTLY 6 images total — one per shot in the chosen category's shot list. No more, no fewer.\\n• Each image is its OWN standalone VERTICAL 9:16 frame (portrait, clearly taller than wide). Every single image must be 9:16 — including close-ups.\\n• NO grids, collages, contact sheets, side-by-sides, diptychs, variations, alternates or retries of any shot.\\n• NO added text, captions, titles, labels, stickers, logos, watermarks or graphics anywhere in any image.\\n• STOP after the sixth image.\\n\\nGenerate 6 distinct, separate, imperfect-framing and lighting, person-in-photo UGC-style phone camera photos of the exact product shown across the provided multi-angle reference images.\\n\\nProduct size, as specified by the user: `{{size}}`\\n\\nRender the product at exactly this size relative to hands, faces and furniture. Check it against the hand holding it — a small object is largely enclosed by the fingers; a large one dwarfs the hand. Never inflate a small product to make it more visible.\\n\\nOUTPUT: exactly 6 images, one per shot below, each its own standalone vertical 9:16 snapshot. No variations, no retries, no two alike. Never a grid, collage or composite. Stop after the sixth.\\n\\nPRODUCT LOCK: strictly base the product's shape, proportions, colors, materials, textures, labels, text, logos and every visible detail exclusively on the uploaded reference photos. Do not invent, add or hallucinate any unseen parts or features. If the reference images have poor or uneven lighting, subtly improve exposure and clarity to make details visible while keeping a natural unretouched phone-camera aesthetic.\\n\\nPEOPLE: each photo features a different person, and each must be a logical owner of this product — someone from its actual largest target audience. Invent six new people for this run: specific, ordinary faces you'd see in a supermarket, not a catalogue. Vary age, build, hair and style within the real audience. Never reuse a cast between runs. Everyone is having a fine ordinary day — relaxed, warm, at ease. Never frowning, tense, bored, tired or blank, and never a performed smile at the lens.\\n\\nLOOK: casual, slightly imperfect phone-snapshot composition, natural skin texture and fine lines, authentic shadows, natural reflections. Real phone camera qualities: slight grain, natural color cast, believable depth of field. No portrait-mode blur. No studio polish, no commercial lighting, no over-sharpening, no plastic smoothness, no added text or logos, no changes to the product itself. Infer the brand's vibe from the reference photos where possible.\\n\\n**STEP 1: Classify the product into ONE category below. Use that category's shot list, settings and lighting. Ignore the other categories entirely.**\\n\\n**BEAUTY \u0026 SKINCARE — serums, cleansers, makeup, hair products and tools**\\nAudience: skews female, late teens to 40s, occasionally older for anti-ageing.\\nShots: 1) bathroom mirror selfie, phone visible, product held near the face · 2) extreme close-up of application on skin or hair, face partly in frame · 3) fresh-faced after-use portrait in bathroom light, skin visibly good · 4) the shelfie — product among their other bottles on a cluttered shelf or counter, hand reaching in · 5) morning routine at the sink, mid-step, not looking at camera · 6) held up beside the face in bedroom light, easy smile.\\nLight: bright bathroom daylight, warm bedroom lamp, harsh-ish vanity light on one. Settings: bathroom, bedroom, vanity.\\n\\n**SUPPLEMENTS \u0026 WELLNESS — powders, capsules, drinks, sleep aids**\\nAudience: 25–45, health-conscious, gym-adjacent or busy-professional.\\nShots: 1) scoop mid-pour into a glass or shaker on a kitchen counter · 2) the mixed drink held up, product tub behind it · 3) taking it as part of a morning routine, kitchen, mid-action · 4) product on a counter among coffee, keys and a water bottle · 5) post-workout, slightly sweaty, drinking it · 6) evening wind-down version if the product suits it — bedside, lamp light.\\nLight: bright morning kitchen daylight, cool gym light, warm bedside lamp. Settings: kitchen, gym bag, bedside.\\n\\n**APPAREL \u0026 ACCESSORIES — clothing, bags, shoes, jewellery, activewear**\\nAudience: matches the garment's own demographic exactly.\\nShots: 1) full-length mirror selfie, phone in frame, whole outfit visible · 2) fit check turning slightly, caught mid-movement · 3) close detail — fabric, stitching, hardware, on the body · 4) worn out in the world, candid, shot by a friend · 5) laid on a bed with other items, overhead haul shot, hands in frame · 6) sitting somewhere casual, wearing it, relaxed and unposed.\\nLight: bedroom daylight, hallway mirror light, outdoor overcast or golden. Settings: bedroom, hallway, outside.\\n\\n**FOOD \u0026 BEVERAGE — snacks, drinks, meal kits, sauces**\\nAudience: broad; skew to the product's price and occasion.\\nShots: 1) the bite or the sip, mid-action, close · 2) genuine reaction right after tasting · 3) the pour or the plate-up, hands and product · 4) packaging open on a counter mid-preparation, ingredients around · 5) in the fridge or the cupboard among real groceries · 6) shared at a table, someone reaching in.\\nLight: bright kitchen daylight, warm dinner-table lamp, cool fridge light. Settings: kitchen, dining table, sofa.\\n\\n**HOME \u0026 KITCHEN — gadgets, tools, cleaning, organisation**\\nAudience: 25–55, homeowners and renters, practical buyers.\\nShots: 1) the product doing its job in close-up, hands only, no face · 2) the result — the clean surface, the finished dish, the organised drawer · 3) person mid-use, looking down at the task, absorbed · 4) before-and-after style single frame if the product transforms something · 5) sitting on the counter where it lives, in context · 6) person stepping back looking pleased at the result.\\nLight: hard kitchen daylight, overhead utility light, warm evening. Settings: kitchen, bathroom, laundry, garage.\\n\\n**BABY \u0026 PARENTING — gear, feeding, sleep, toys**\\nAudience: parents 25–40, tired and practical.\\nShots: 1) parent using it with the baby, absorbed, not looking at camera · 2) close on the product in use, hands and baby only · 3) the baby using or wearing it, parent partly in frame · 4) in the nappy bag or on the changing table among real clutter · 5) parent one-handed, mid-task, real domestic chaos around · 6) calm moment after — the thing worked, quiet relief.\\nLight: soft nursery daylight, dim night-light, bright living room. Settings: nursery, living room, car, changing table.\\n\\n**PET — food, toys, beds, grooming, accessories**\\nAudience: 25–55, the pet is the point.\\nShots: 1) the pet using, eating or wearing it, owner's hands only · 2) pet mid-action with it, slightly blurred, candid · 3) owner and pet together, owner watching the pet, not the camera · 4) product on the floor among the pet's other things · 5) close on the pet's face with the product in frame · 6) walk or outdoor use if the product suits it.\\nLight: living-room daylight, kitchen floor light, outdoor overcast. Settings: living room, kitchen floor, garden, on a walk.\\n\\n**TECH \u0026 TRAVEL ACCESSORIES — cases, chargers, earbuds, bags, organisers**\\nAudience: 22–45, commuters, travellers, remote workers.\\nShots: 1) in use in the real context — desk, train, airport, car · 2) close on hands operating or opening it · 3) packed with its actual contents, spread on a surface, hands sorting · 4) clipped to a bag or in a pocket, on the move, mid-stride · 5) on a desk or table among everyday things, person behind it doing something else · 6) person glancing at the camera mid-use, relaxed.\\nLight: office daylight, train window light, warm desk lamp, airport fluorescents. Settings: desk, train, airport, car, hallway.\\n\\n**STEP 2: Generate the six shots for the chosen category. Vary the room, time of day, camera distance and angle across them. No more than two photos have the person looking at the lens.** Output each of the six as a separate vertical 9:16 portrait image (taller than wide), even the close-ups — never a horizontal or square frame, and exactly six in total.\\n\\n=== USER INPUT ===\\nProduct size: {{size}}\\nExact size: {{custom_size}}\\nVibe notes: {{vibe}}\",\"variants\":[{\"inputs\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-18-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-18-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-19-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-19-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-37-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-37-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-15-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-15-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-21-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/ugc_image/variants/UGC-21-output.jpg?v=20260723\"}]},{\"id\":\"imagine-mascot-maker\",\"title\":\"Mascot Maker\",\"description\":\"Turn a one-line concept into an original, production-ready game mascot: one full-body character with a strong iconic silhouette, a memorable color identity, and tons of personality — centered on a keyable (transparent) background, sprite-base ready. Pairs naturally with Character Sprite Maker to animate your mascot into engine-ready sprite sheets.\",\"category\":\"Design Tools\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/mascot_maker_cover.jpg?v=5\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/mascot_maker_vertical.jpg?v=3\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image\"},{\"label\":\"Options\",\"value\":\"1\"},{\"label\":\"Images\",\"value\":\"0\"}],\"presetInputs\":[{\"id\":\"art_style\",\"label\":\"Style\",\"description\":\"The art style for your mascot. Leave unset for the polished 2D game-mascot look.\",\"default\":\"game-mascot\",\"options\":[{\"label\":\"Polished 2D game mascot\",\"value\":\"game-mascot\",\"prompt\":\"game-mascot: polished 2D game mascot art — bold clean dark outlines, vibrant saturated colors, soft cel shading, chunky readable shapes, big expressive eyes, high contrast, crisp edges, no photorealism.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/style_game_mascot.jpg?v=3\"},{\"label\":\"Chibi cute\",\"value\":\"chibi\",\"prompt\":\"chibi: cute chibi proportions — oversized head, tiny body, maximum charm.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/style_chibi.jpg?v=3\"},{\"label\":\"Retro cartoon\",\"value\":\"retro-cartoon\",\"prompt\":\"retro-cartoon: rubber-hose / classic-cartoon energy, bold and bouncy.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/style_retro_cartoon.jpg?v=3\"},{\"label\":\"Flat vector\",\"value\":\"flat-vector\",\"prompt\":\"flat-vector: clean flat vector shapes, minimal shading, mascot-logo ready.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/style_flat_vector.jpg?v=3\"},{\"label\":\"Painterly\",\"value\":\"painterly\",\"prompt\":\"painterly: rich hand-painted illustration with soft rendered volume.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/style_painterly.jpg?v=3\"},{\"label\":\"Pixel art\",\"value\":\"pixel\",\"prompt\":\"pixel: true chunky pixel art, hard stair-stepped edges, a limited palette, no anti-aliasing.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/style_pixel.jpg?v=3\"}]},{\"id\":\"background\",\"label\":\"Background\",\"description\":\"What sits behind the mascot. Transparent (keyable) by default so it drops straight into a game or Character Sprite Maker.\",\"default\":\"transparent\",\"options\":[{\"label\":\"Transparent\",\"value\":\"transparent\",\"prompt\":\"transparent: deliver the mascot as a clean cutout on a fully transparent background (alpha), edges tight, ready to composite.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/bg_transparent.png?v=1\"},{\"label\":\"Chroma key\",\"value\":\"chroma-magenta\",\"prompt\":\"chroma-magenta: a solid flat chroma-key magenta (#FF00FF) fill for easy keying (use solid green if the character itself is magenta).\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/bg_chroma_magenta.png?v=1\"}]}],\"imageInputs\":[],\"textInputs\":[{\"id\":\"concept\",\"label\":\"Mascot concept\",\"required\":true,\"multiline\":true,\"placeholder\":\"The character in a line, e.g. \\\"a punk shark in a leather jacket\\\" or \\\"a tiny mushroom knight\\\".\",\"example\":\"a punk shark in a leather jacket\"},{\"id\":\"color_palette\",\"label\":\"Color palette (optional)\",\"required\":false,\"placeholder\":\"Optional: dominant colors, e.g. \\\"electric blue + storm grey + yellow\\\".\"},{\"id\":\"notes\",\"label\":\"Notes (optional)\",\"required\":false,\"placeholder\":\"Anything specific: a signature pose, an accessory, a vibe.\"}],\"inputOrder\":[\"concept\",\"art_style\",\"color_palette\",\"background\",\"notes\"],\"promptTemplate\":\"Design ONE original, production-ready GAME MASCOT character from the concept under USER INPUT — a single clean full-body character render, centered on a keyable background, ready to drop into a game, a store page, or straight into Character Sprite Maker to be animated.\\n\\nWHAT MAKES A GREAT MASCOT (the whole craft):\\n- ONE character, instantly readable, bursting with personality — a clear archetype a player remembers after a single glance.\\n- A STRONG ICONIC SILHOUETTE: pose and shapes read even as a solid black shape. Chunky, confident, well-separated forms; no thin fiddly bits that vanish at small sizes.\\n- Big expressive eyes / face, an appealing modern character-design sensibility, and a distinct color identity.\\n- ORIGINAL: invent the character; never copy or closely imitate an existing brand, franchise, or trademarked mascot, even if asked.\\n\\nFRAMING (non-negotiable, so the mascot is sprite/cutout ready):\\n- FULL BODY head-to-toe, the ENTIRE character fully inside the frame with generous even margin on all four sides.\\n- Centered, standing hero pose facing the viewer (unless the concept implies a signature stance).\\n- Isolated on the chosen BACKGROUND, absolutely nothing else in the scene: no text, no logo, no watermark, no drop shadow, no ground plane, no extra props outside the character.\\n- Output a single clean image.\\n\\nART STYLE — render in the style specified under USER INPUT; if none is given, use the polished 2D game mascot style: bold clean dark outlines, vibrant saturated colors, soft cel shading, chunky readable shapes, big expressive eyes, high contrast, crisp edges, no photorealism.\\n\\nCOLOR — if a palette is given under \\\"Palette\\\", build the character's identity around it (one or two dominant hues + an accent); otherwise choose a bold, high-contrast palette that fits the concept and gives the mascot a memorable color signature.\\n\\nBACKGROUND — follow the background specified under USER INPUT; if none is given, deliver the mascot as a clean cutout on a fully transparent background (alpha), edges tight, ready to composite.\\n\\nPAIRS WITH CHARACTER SPRITE MAKER: this mascot is built sprite-base ready — a full-body, centered, strong-silhouette character on a keyable background. Hand the result to Character Sprite Maker to turn it into animated, engine-ready sprite sheets (idle / run / attack and more).\\n\\nONE SHOT: do not ask questions; use sensible defaults for anything the form leaves open.\\n\\n=== USER INPUT ===\\nMascot concept: {{concept}}\\nStyle: {{art_style}}\\nPalette: {{color_palette}}\\nBackground: {{background}}\\nExtra notes: {{notes}}\\n\",\"variants\":[{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/variants/MSC-01-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/variants/MSC-11-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/variants/MSC-25-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/variants/MSC-50-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/mascot_maker/variants/MSC-17-output.jpg\"}]},{\"id\":\"imagine-editorial-poster\",\"title\":\"Editorial Product Poster\",\"description\":\"Turn a single product photo into an art-directed, editorial typographic poster.\",\"category\":\"Marketing\",\"coverImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/editorial/editorial_cover.jpg?v=2\",\"coverVerticalImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/editorial/editorial_veritcal.jpg\",\"settings\":[{\"label\":\"Aspect\",\"value\":\"9:16\"}],\"presetInputs\":[{\"id\":\"mode\",\"label\":\"Mode\",\"required\":true,\"options\":[{\"label\":\"Maximal\",\"value\":\"MAXIMAL\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/editorial/maximal_editorial.jpg?v=2\",\"prompt\":\"MAXIMAL (layered, maximalist — equivalent to \\\"Prompt 1\\\")\\n- Signature move: TEXT-BEHIND-PRODUCT OVERLAP. Blow the hero word up huge and layer the product in front\\n  of it so they overlap — this is what creates depth. The hero word MAY be repeated, stacked, or ghosted\\n  behind the product (e.g. a stacked wordmark, a ghosted echo) when it elevates the piece.\\n- Staging is either SURREAL scale-play (product placed in an unexpected oversized/world context to stop the\\n  scroll) OR surgically clean (product floating in near-empty space). No timid middle ground.\\n- Lean into richness within the single color world: full tonal commitment, confident bold+script pairing.\"},{\"label\":\"Minimal\",\"value\":\"MINIMAL\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/editorial/minimal_editorial.jpg?v=2\",\"prompt\":\"MINIMAL (disciplined, single-archetype — equivalent to \\\"Prompt 2\\\")\\nPick the ONE composition archetype that best fits this product:\\n  1. Single hero word overlapping the product (default).\\n  2. Hero word split in two around the product (top-left / bottom-right).\\n  3. Script word + bold display word paired (e.g. \\\"tasty\\\" over \\\"MORNING\\\").\\n  4. Clean minimal: small hero word, product centered, lots of empty space.\\n  5. Color-flooded: badge + headline + product + CTA on one centered axis.\\n\\nAVOID (critical):\\n- Do NOT repeat or stack the same word. State the hero word ONCE. Do not tile or echo the brand name to fill\\n  the background. (A single faint ghost behind the product is allowed only rarely — assume NOT for this poster\\n  unless it clearly elevates it.)\\n- No more than three type families. No rainbow of color. No mid-sized filler text. No busy backgrounds or clip-art.\\n- Staging: surgically clean (product floating in calm space) OR one surreal scale-play idea — nothing in between.\"}]}],\"imageInputs\":[{\"id\":\"product\",\"label\":\"Product image\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"textInputs\":[{\"id\":\"hero\",\"label\":\"Hero\",\"required\":true,\"placeholder\":\"e.g. RADIANCE\"},{\"id\":\"subhead\",\"label\":\"Subtext\",\"required\":true,\"placeholder\":\"e.g. Vitamin C brightening serum\"},{\"id\":\"labels\",\"label\":\"Fine prints (3-5 words)\",\"placeholder\":\"e.g. VEGAN, CRUELTY-FREE, 30ML\"}],\"promptTemplate\":\"ROLE: Expert graphic designer creating professional, high-impact editorial typographic product posters with Grok Imagine.\\n\\nWork in a SINGLE turn: the product picture(s) are attached and the mode + copy are provided in the message below. Do NOT ask clarifying questions; proceed with sensible defaults.\\n\\nPER-IMAGE RULE (both modes): Create ONE complete, ready-to-use vertical poster (9x16) for EACH\\nattached picture. Never combine products across pictures — each user-uploaded picture gets its own poster.\\nUse only the product(s) in that single picture. Output only the finished poster image(s).\\n\\n=== SHARED STYLE DNA (both modes) ===\\nThis is the editorial typographic product poster school — the boutique, \\\"this was art-directed\\\" end:\\n\\nGOVERNING IDEA: Type is the hero, not a label — it IS the artwork. One loud display voice carries the\\nwhole mood; everything else is quiet and functional. The size jump between them is extreme (hero word\\n~10–15x the small print). That violent contrast is the look. Evenly-sized type reads as a brochure, not a poster.\\n\\nTYPE VOICES (use two, three max, in fixed roles):\\n- DISPLAY voice: the big characterful face that sets the emotional tone (brand name or one benefit word).\\n  This is where personality and boldness live.\\n- FUNCTIONAL voice: a plain, neutral sans for ALL small copy (flavor, benefit, size, origin, fine print).\\n  Almost always a clean grotesque (Inter/Helvetica-like) even when the hero is a serif/script — it must\\n  vanish and stay legible. Captions are plumbing, not personality.\\n- ACCENT voice (optional): a script/italic on just ONE or TWO words for tension against the display\\n  (\\\"tasty MORNING,\\\" \\\"ICED\\\" + script \\\"creamy\\\"). Sparingly — never a whole headline.\\n\\nDISPLAY FACE BY FEELING (personality match — what is the product selling?):\\n- Coffee / bakery / comfort food → heavy chunky grotesque or bold condensed sans, often a script accent.\\n- Beauty luxury/feminine → high-contrast Didone serif (Bodoni/Playfair), tight tracking, lots of air.\\n- Beauty clinical/clean → plain modern sans.\\n- Fragrance / luxury / fashion → restrained high-contrast serif, wide spacing, minimal everything.\\n- Health / protein / sports → confident geometric or grotesque sans, uppercase, bold.\\n- Furniture / home / heritage / vintage → transitional/slab serif or retro display face.\\n- Sale / youth / streetwear → heavy condensed caps, or brush/graffiti script for energy.\\nShorthand: warmth/craft → serif or script; modern/functional → sans; luxury → high-contrast serif;\\nloud-and-fun → heavy condensed caps.\\n\\nTYPE BEHAVIOR:\\n- Case: display = bold UPPERCASE for impact OR styled lowercase script; micro-copy = UPPERCASE, wide\\n  letter-spacing; subhead/description = sentence case, neutral sans.\\n- Spacing: big display = tight tracking + tight leading (reads as one solid mass); tiny labels = wide-tracked.\\n- Scale: commit to the jump. If the hero is huge, support text should feel almost too small. No mid-sized\\n  type competing in between.\\n- Color: ONE color world — a single tonal palette (oxblood, cream, lilac, brown, sage, pink, etc.) shared by\\n  background, product, and type. Keep type to one or two colors from that palette. Never a rainbow.\\n- Placement: display type is a graphic element — it may bleed off edges and overlap/sit behind the product.\\n- Micro-copy: 3–5 tiny wide-tracked uppercase callouts pinned in the corners to frame the hero without crowding.\\n\\nTHE EARNED SURPRISE: Pick your defaults from above, then deliberately break exactly ONE convention for\\ndistinctiveness (a serif where everyone uses a sans; one word in an unexpected script). One earned surprise,\\neverything else disciplined.\\n\\nUNIVERSAL DESIGN RULES:\\n- Bold, highly readable text with strong hierarchy; the headline clearly dominates.\\n- High-quality, relevant staging/elements that fit the theme; clean, balanced composition, good spacing.\\n- All provided text integrated crisply, legibly, and correctly spelled.\\n\\nMODE — the chosen mode (MAXIMAL or MINIMAL) arrives fully specified under USER INPUT; execute it exactly.\\n\\nOUTPUT: One finished vertical 9x16 poster per attached picture. Text crisp, correctly spelled, strong\\nhierarchy, hero word stands out.\\n\\n=== USER INPUT ===\\nMode: {{mode}}\\nHero word / headline: {{hero}}\\nSubhead / details: {{subhead}}\\nMicro-copy labels (3-5 short): {{labels}}\",\"variants\":[{\"inputs\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-01-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-01-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-44-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-44-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-16-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-16-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-13-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-13-output.jpg\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-28-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/editorial/variants/EDP-28-output.jpg\"}]},{\"id\":\"imagine-professional-headshot\",\"title\":\"Professional Headshot\",\"description\":\"Turn any casual photo into a LinkedIn-grade professional headshot — unmistakably the same person, with professionalized attire, backdrop, and lighting.\",\"category\":\"Photo Tools\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image\"},{\"label\":\"Images\",\"value\":\"1\"}],\"presetInputs\":[{\"id\":\"attire\",\"label\":\"Attire\",\"required\":true,\"options\":[{\"label\":\"Business Suit\",\"value\":\"suit\",\"prompt\":\"a fully tailored dark suit JACKET worn with a crisp white or light-blue dress shirt and a tie (for a woman: the tailored dark suit jacket over a formal silk blouse) - unmistakably formal business dress; the jacket and tie/formal blouse must be clearly visible\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/professional_headshot/attire_suit_sq.jpg\"},{\"label\":\"Business casual\",\"value\":\"business-casual\",\"prompt\":\"business casual with NO tie and NO formal suit: an open-collar shirt or blouse (top button open), worn alone, under a fine knit sweater, or under a soft unstructured blazer - clearly more relaxed than a formal suit at a glance\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/professional_headshot/attire_bizcasual_sq.jpg\"},{\"label\":\"Neutral\",\"value\":\"neutral\",\"prompt\":\"Minimal, modern neutral clothing, and clearly neither a suit nor an office shirt.\",\"imageUrl\":\"https://imagine-public.x.ai/agent-skills/professional_headshot/attire_creative_sq.jpg?v=2\"}]}],\"textInputs\":[{\"id\":\"notes\",\"label\":\"Notes (optional)\",\"required\":false,\"placeholder\":\"Optional: anything specific you want\"}],\"imageInputs\":[{\"id\":\"sourcePhoto\",\"label\":\"Your photo\",\"description\":\"A casual photo of you — selfie, candid, anything where your face is clearly visible.\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"inputOrder\":[\"sourcePhoto\",\"attire\"],\"promptTemplate\":\"Transform the attached photo into a professional studio-grade headshot suitable for LinkedIn, a company directory, or a resume, using the attire specified under USER INPUT.\\n\\nFIRST, VALIDATE THE SOURCE PHOTO - before anything else, check that the attached photo clearly shows the person's face. If the face is occluded, turned away from the camera, cropped out of frame, or too small or too blurred to confidently identify the person, DO NOT generate any image. Reply in text only, stating that a clear photo of the person's face is needed to create a professional headshot, and briefly say what was wrong with this one (for example: the face is hidden or turned away). Fabricating an identity is the one unforgivable failure for this skill - a confident headshot of an invented face is far worse than no image at all. When in doubt about whether the face is identifiable, decline.\\n\\nTHE PERSON MUST REMAIN UNMISTAKABLY THE SAME PERSON - identity fidelity overrides every stylistic goal. Preserve exactly: face geometry and proportions, eye shape and color, nose, mouth, jawline, ears, skin tone and real skin texture, exact hair color, and exact hair style, texture, length, and hairline detail, forehead size, facial hair exactly if there is any in the user-uploaded photo, and the person's actual body type and apparent age. Do not slim the face or body, do not de-age, do not enlarge the eyes, do not straighten or whiten teeth beyond how they appear in the source, and do not airbrush the skin smooth.\\n\\nProfessionalize ONLY these:\\n\\n- Attire: dress the person in the requested attire EXACTLY as described, fitted naturally to their actual build - the attire choice must be obvious at a glance (a suit must read as a suit with jacket and tie/formal blouse; business casual must clearly have no tie; creative must have no collar or jacket).\\n- Backdrop: replace the background with a clean professional backdrop that suits the person and the attire - a seamless studio shot background, a bokeh realistic modern office, open bokeh realistic daylight outdoors, or a bokeh minimalist indoors interior.\\n- Lighting: soft, flattering professional portrait lighting - a gentle key with soft fill, natural catchlights in the eyes, no harsh shadows, no blown highlights.\\n- Pose and framing: frame as a classic head-and-shoulders crop with the eyes in the upper third and a little headroom (the standard for LinkedIn and directory photos); shoulders angled slightly, face toward the camera, posture confident and relaxed, expression natural and approachable, close to the expression in the source (a slight professional smile is ideal). If the source shows an unusual, exaggerated, playful, or inappropriate posture, gesture, or expression - for example dabbing, a peace sign or other hand signs, arms raised or flailing, a dramatic lean, or a silly face - do NOT reproduce it: reframe the SAME person into this natural, relaxed, professional head-and-shoulders pose with a neutral-friendly expression, keeping their identity, face, likeness, and hair intact (attire and backdrop still follow USER INPUT).\\n- Cleanup: subtly neaten stray hairs and clothing wrinkles, and remove photographic defects (noise, motion blur, red-eye, harsh on-camera flash) - while keeping skin texture detailed.\\nIf the person wears glasses on their nose and eyes in the source, keep the same glasses with no lens glare. Keep any visible cultural or religious head covering exactly as worn. If the source contains more than one person, the subject is the most prominent person. Output 2-3 photorealistic portrait-orientation headshots of the SAME person in the SAME attire - each a different tasteful variation (a different angle, pose, or backdrop treatment), every one meeting every rule above. Never more than 3 pictures. Stop at 3. If the user’s input picture is hrizontal aspect ratio, still generate a vertical format for the output.\\n\\n=== USER INPUT ===\\nAttire: {{attire}}\\nExtra notes: {{notes}}\\n\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/professional_headshot/professional_headshot_cover.jpg?v=9\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/professional_headshot/professional_headshot_vertical.jpg?v=9\",\"variants\":[]},{\"id\":\"imagine-room-staging\",\"title\":\"Room staging (empty to furnished)\",\"description\":\"Virtually stage an empty room with furniture and decor in a chosen staging style.\",\"category\":\"Interior\",\"coverImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Template_Cover_Room%20stating.jpg?v=3\",\"coverVerticalImageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/room_staging_vertical.jpg?v=1\",\"presetInputs\":[{\"id\":\"style\",\"label\":\"Style\",\"description\":\"Pick the staging style.\",\"required\":true,\"options\":[{\"label\":\"Transitional\",\"value\":\"Transitional\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Room%20stating_Neutral_Transitional.jpg\",\"prompt\":\"Transitional — Warm neutrals (greige, taupe, cream, soft white) with one muted accent (soft blue or sage) — mixed wood and upholstery, brushed metal, natural fibers — comfortable classic-but-clean pieces: a track-arm sofa, a pair of accent chairs, a wood coffee table, a console — textured throws and cushions, a large neutral rug, calm abstract art, a plant or two, warm table lamps — soft, even, inviting light. The crowd-pleaser default: comfortable and current, never trendy or polarizing. Works for almost any listing.\"},{\"label\":\"Contemporary\",\"value\":\"Contemporary\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Room%20stating_Contemporary.jpg\",\"prompt\":\"Contemporary — Crisp neutrals (white, grey, charcoal) with clean black accents — glass, matte and polished metal, smooth surfaces — a sleek low-profile sofa, clean-lined chairs, a simple coffee table, a minimal console — a few cushions, one large modern artwork, a sculptural plant, a statement fixture, clear surfaces — bright, clean, modern light. Current and widely appealing; ideal for new builds and condos.\"},{\"label\":\"Modern Farmhouse\",\"value\":\"Modern Farmhouse\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Room%20stating_Modern%20farmhouse.jpg\",\"prompt\":\"Modern Farmhouse — Warm white, cream, soft greige with black accents and natural wood — light and reclaimed wood, matte black metal, woven baskets — a comfortable slipcovered sofa, a wood-and-metal coffee table, cozy accent chairs, a console — linen and chunky-knit textiles, a jute or wool rug, simple greenery, a few framed prints, black or lantern-style fixtures — warm, cozy, sunlit. Familiar and welcoming; strong in suburban and family markets.\"},{\"label\":\"Scandinavian / Light Minimalist\",\"value\":\"Scandinavian / Light Minimalist\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Room%20stating_Scandinavian%20Light%20Minimalist.jpg\",\"prompt\":\"Scandinavian / Light Minimalist — Bright white with pale wood and soft muted accents — light oak/birch, white, natural fibers — simple low-profile furniture on tapered legs: a light sofa, a slim coffee table, an accent chair — a soft throw, a sheepskin, one rug, a single large plant, minimal art — abundant soft natural light; airy and uncluttered. Makes small rooms feel bigger and brighter; great for apartments, condos, and younger buyers.\"},{\"label\":\"Coastal\",\"value\":\"Coastal\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Room%20stating_Coastal.jpg\",\"prompt\":\"Coastal — Crisp white with soft blue, seafoam, and sandy beige — driftwood-toned wood, rattan, jute, rope, linen — a relaxed slipcovered sofa, woven accent chairs, a light wood coffee table — breezy linen textiles, a natural-fiber rug, subtle coastal art, sheer curtains, a few plants — bright, sunny, airy light. Essential for beach, lake, and waterfront listings; serene and light.\"},{\"label\":\"Mid-Century Modern\",\"value\":\"Mid-Century Modern\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Room%20staging_Mid-century%20modern.jpg\",\"prompt\":\"Mid-Century Modern — Warm neutrals with walnut and restrained mustard/teal accents — walnut, leather, brass — a tapered-leg sofa, an organic curved accent chair, a low walnut coffee table — a geometric rug, a couple of cushions, retro-leaning art, a sculptural lamp, a plant — warm even light. For urban, design-conscious buyers and period homes.\"},{\"label\":\"Modern Luxe\",\"value\":\"Modern Luxe\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Room%20staging_Modern%20luxe.jpg\",\"prompt\":\"Modern Luxe — Soft neutrals (greige, ivory, taupe) with deep accents and gold/brass — marble, velvet, brass, polished wood, glass — a plush sophisticated sofa, elegant accent chairs, a marble-top coffee table, a statement console — velvet cushions, a high-end rug, large framed art, a sculptural chandelier, fresh flowers — warm, layered, flattering light. For premium listings where staging must justify the price.\"},{\"label\":\"Industrial\",\"value\":\"Industrial\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Room%20staging__Industrrial.jpg?v=20260723\",\"prompt\":\"Industrial — Warm greys and browns with black metal, kept inviting not raw — exposed-brick feel, wood, blackened steel, leather — a leather or neutral sofa, a metal-and-wood coffee table, an accent chair — a textured rug, softening cushions, framed prints, Edison-style fixtures, greenery — warm directional light. Lofts and warehouse conversions; soften the rawness so it still feels like home.\"},{\"label\":\"Rustic / Mountain\",\"value\":\"Rustic / Mountain\",\"imageUrl\":\"https://storage.googleapis.com/imagine-public.x.ai/agent-skills/room_staging/Room%20staging_Rustic%20mountain.jpg?v=20260723\",\"prompt\":\"Rustic / Mountain — Warm earthy browns, stone, cream — reclaimed wood, stone, leather, wool — a comfortable leather or upholstered sofa, a chunky wood coffee table, cozy chairs — wool and plaid throws, a textured rug, simple nature-themed art, lantern lighting — warm, firelit-feel glow. Cabins and mountain or rural markets; cozy without feeling heavy.\"}]}],\"imageInputs\":[{\"id\":\"room\",\"label\":\"Empty room photo\",\"description\":\"Upload a photo of the empty room to stage.\",\"required\":true,\"minImages\":1,\"maxImages\":1}],\"textInputs\":[{\"id\":\"requests\",\"label\":\"Furniture \u0026 decor requests\",\"multiline\":true,\"placeholder\":\"Optional — anything specific to include (otherwise furnished to suit the room)\"}],\"promptTemplate\":\"You are an expert interior designer and virtual home stager using Grok Imagine.\\nTask: Virtually stage the uploaded empty room — add furniture and decor to make it feel inviting and help a buyer picture living there. Do not alter the room itself.\\nHard requirements\\n\\n- Preserve the room exactly: walls, windows, doors, flooring, ceiling, built-ins, and camera angle. Only add furniture and decor.\\n- Realistic placement and scale — furniture sized correctly to the room and to each other, grounded with correct contact shadows.\\n- Professional, natural lighting consistent with the room's existing light sources; soft realistic shadows.\\n- Photorealistic and inviting.\\n- Output only the final staged image.\\n\\nStaging principles (apply to every style)\\nThese reflect how professional stagers actually work — follow them regardless of style.\\n\\n1. Depersonalize and keep it broadly appealing. Neutral, aspirational styling that the widest range of buyers can imagine themselves in. No bold personal taste, no clutter, no busy patterns.\\n2. Give the room a clear purpose and a focal point. Arrange furniture into an obvious, functional layout (a conversation area, a defined dining zone, etc.).\\n3. Furnish fully but don't overcrowd. Enough to show the room works; never so much that it feels cramped. Keep clear walkways and an open, easy-to-read floor plan — making the space feel larger is the goal.\\n4. Scale to the space. Right-size pieces so the room looks proportioned and spacious, not stuffed or sparse.\\n5. Keep it light and warm. Bright, welcoming, move-in ready.\\n\\nStyle — the chosen style arrives fully specified under USER INPUT (palette — materials/finishes — furniture — textiles \u0026 decor — lighting/mood). Apply every element of it.\\n\\n=== USER INPUT ===\\nSelected style: {{style}}\\nFurniture \u0026 decor requests: {{requests}}\",\"variants\":[{\"inputs\":\"https://imagine-public.x.ai/agent-skills/room_staging/variants/RMS-07-input.jpg\",\"output\":\"https://imagine-public.x.ai/agent-skills/room_staging/variants/RMS-07-output.jpg?v=20260723\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/room_staging/variants/RMS-22-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/room_staging/variants/RMS-22-output.jpg?v=20260723\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/room_staging/variants/RMS-02-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/room_staging/variants/RMS-02-output.jpg?v=20260723\"},{\"inputs\":\"https://imagine-public.x.ai/agent-skills/room_staging/variants/RMS-09-input.jpg?v=20260723\",\"output\":\"https://imagine-public.x.ai/agent-skills/room_staging/variants/RMS-09-output.jpg?v=20260723\"}]},{\"id\":\"game-props-ui-kit\",\"title\":\"Props \u0026 UI Kit\",\"description\":\"Generate matching game props, item icons, buttons, and panels - one style contract, engine-ready.\",\"category\":\"Game Assets\",\"coverImageUrl\":\"https://imagine-public.x.ai/agent-skills/props_ui_kit/props_ui_kit_cover.jpg?v=5\",\"coverVerticalImageUrl\":\"https://imagine-public.x.ai/agent-skills/props_ui_kit/props_ui_kit_vertical.jpg?v=3\",\"settings\":[{\"label\":\"Mode\",\"value\":\"Image Editing\"}],\"presetInputs\":[{\"id\":\"style\",\"label\":\"Style\",\"required\":true,\"options\":[{\"label\":\"Pixel Art\",\"value\":\"Pixel art - crisp pixel grid, limited retro color palette, hard edges, no anti-aliasing, readable at small sizes\",\"imageUrl\":\"https://app-media.x.ai/ios/agent-skills/game-kit-style-pixel.jpg\"},{\"label\":\"Cel-Shaded 2D\",\"value\":\"Cel-shaded 2D game art - clean bold outlines, flat cel shading, vibrant saturated colors, modern mobile-game look\",\"imageUrl\":\"https://app-media.x.ai/ios/agent-skills/game-kit-style-cel.jpg\"},{\"label\":\"Hand-Painted\",\"value\":\"Hand-painted 2D game art - painterly brushwork, soft rendered shading and highlights, rich fantasy RPG splash-art feel\",\"imageUrl\":\"https://app-media.x.ai/ios/agent-skills/game-kit-style-painted.jpg\"},{\"label\":\"3D Render\",\"value\":\"Polished stylized 3D render - smooth toy-like forms, soft studio lighting, subtle reflections, pre-rendered game-model look\",\"imageUrl\":\"https://app-media.x.ai/ios/agent-skills/game-kit-style-3d.jpg\"}]},{\"id\":\"contents\",\"label\":\"Kit contents\",\"description\":\"Pick one or several - everything generates under one style contract.\",\"required\":true,\"multiSelect\":true,\"options\":[{\"label\":\"World Props\",\"value\":\"World props - in-scene objects (crates, lamps, plants, furniture) at believable relative scale\",\"imageUrl\":\"https://app-media.x.ai/ios/agent-skills/game-kit-props.jpg\"},{\"label\":\"Icon Set\",\"value\":\"Icon set - inventory/ability/resource icons with one style contract, uniform padding, readable at 32px\",\"imageUrl\":\"https://app-media.x.ai/ios/agent-skills/game-kit-icons.jpg\"},{\"label\":\"Buttons\",\"value\":\"Buttons - each button in three geometry-identical interaction states (normal, hover, pressed)\",\"imageUrl\":\"https://app-media.x.ai/ios/agent-skills/game-kit-buttons.jpg\"},{\"label\":\"Panels \u0026 Bars\",\"value\":\"Panels and bars - blank text-ready dialog panels/frames that survive 9-slicing, plus progress bars with separate frame and fill\",\"imageUrl\":\"https://app-media.x.ai/ios/agent-skills/game-kit-panels.jpg\"}]}],\"textInputs\":[{\"id\":\"description\",\"label\":\"What's in the kit\",\"required\":true,\"multiline\":true,\"placeholder\":\"Describe the theme and list what you need - e.g. \\\"medieval fantasy: barrel, lantern and cart props; sword, potion, shield, key icons; a pause button; a quest dialog panel and a health bar\\\". Leave it open and we'll pick a matching set.\"}],\"imageInputs\":[{\"id\":\"reference\",\"label\":\"Reference (optional)\",\"description\":\"Optional style reference - existing game art the kit should match.\",\"required\":false,\"minImages\":0,\"maxImages\":3}],\"inputOrder\":[\"style\",\"contents\",\"description\",\"reference\"],\"promptTemplate\":\"You are a game-asset generation specialist working in Grok Imagine. The user tells you WHAT they need; making it ENGINE-READY is your job. Follow this discipline for every asset.\\n\\nEngine-ready defaults (apply unless the brief below overrides them):\\n- Isolate subjects on a flat, uniform, high-contrast backdrop (a solid color not present in the subject) - no scene, ground plane, or cast shadow; clean, readable silhouette.\\n- DELIVER every sprite with its background actually removed, not just keyable: run the finished subject through the Extract Subject tool (imagine_extract_subject - it cuts the subject onto a transparent RGBA PNG while preserving the ORIGINAL pixels, so fur and fine edges survive) and hand back that transparent cutout, not the flat-backdrop image, so the sprite drops straight into an engine. Extract one image at a time (pass the subject when a frame shows more than one). Exception: full seamless tiles/textures and full UI panels are delivered whole - never cut those out.\\n- Use even, non-directional lighting unless a light direction is requested.\\n- Lead every image prompt with the chosen art style (given under USER INPUT) and repeat those style words in EVERY generation and EVERY edit — edits that drop the style words drift toward photorealism.\\n- No text or lettering anywhere unless the brief explicitly asks for it (image models garble text and games localize).\\n- For any SET of related assets (poses, states, views, icons, frames), generate ONE base image, then produce the rest by editing FROM that base so they share identity, palette, scale, padding, and style. Regenerating each from scratch breaks the set.\\n\\nWorking method:\\n- Write vivid 2-5 sentence prompts. Express counts and geometry as visual configurations (positions, groupings), not bare numbers.\\n- Verify every output: describe what the image actually shows, then diff it against the brief and these defaults - isolated background? style match? set-consistent? Fix misses with a targeted edit. If the generator keeps failing the same point, keep the best result and flag it honestly rather than shipping a silent defect.\\n- Deliver clearly named files and state intended usage (recommended size, etc.) plus any unresolved defect or default you deviated from.\\n\\nBegin immediately from the provided style, selections, and description (plus any attached reference) - do not ask for approval or restate this skill. Only ask a question if the request is too sparse to start.\\n\\nTASK - PROPS \u0026 UI KIT: produce a cohesive pack of game props and/or UI elements that reads as ONE game's art. The KIT CONTENTS below lists which parts were requested (one or several); build every requested part under a single style contract so everything matches.\\n\\nStyle contract FIRST, before any generation: one outline treatment, one palette family, one level of detail, one lighting scheme for the entire kit. Generate the single most representative asset as the anchor, verify it, then edit-chain every other asset FROM it (or its nearest finished neighbor) - across categories too: the icons, buttons, and panels must read as one interface. Never regenerate kit members from scratch.\\n\\nPer-content rules:\\n- WORLD PROPS: in-scene objects at believable RELATIVE scale between props (a barrel is not taller than a door); grounded stance but NO baked ground plane or cast shadow. Deliver as individual transparent cutouts named by prop.\\n- ICON SET: one icon per item, centered with UNIFORM padding across the set, same fill treatment on every icon (all outlined or all solid - never mixed), same visual weight. Every icon must read at 32px - squint-test the thumbnail and redo any icon that turns to mush. Deliver as individual transparent cutouts.\\n- BUTTONS: generate the NORMAL state first; hover and pressed are edits of it with an explicit freeze-list (\\\"same shape, same size, same ornament, same frame thickness - change ONLY the state treatment\\\"). Standard treatments: hover = subtle outer glow or slight brighten; pressed = darker with an inset/inner shadow. States must be distinguishable at a glance AND identical in geometry - overlay-compare them; the outlines must coincide, frame thickness included. Button faces stay blank: labels and glyphs are composited in-engine.\\n- PANELS \u0026 BARS: panels/dialogs blank and text-ready, with borders that survive 9-slicing (uniform edges, ornament concentrated in the corners). Bars with clear frame-vs-fill separation, and a fill design that works at any percentage - deliver frame and fill as separate pieces when possible. Deliver panels and bars WHOLE, never cut out.\\n\\nKit-wide rules:\\n- If the brief leaves counts open, choose a sensible set (roughly 6-8 props, 6-10 icons, 2-3 buttons, 1 panel + 1 bar for the requested parts) and name every file.\\n- No text or lettering on ANY kit asset - including button labels and panel titles (games localize).\\n- Verify the kit side by side: one style, one palette family, no odd-one-out. An icon sitting in a filled tile while the others float fails the SET even if it is fine alone; a button state that shifted geometry fails the TRIPLET. One mismatch -\u003e re-edit only that asset.\\n\\nFINAL DELIVERY — ONE COMBINED, POLISHED KIT SHEET (do this LAST, after the individual assets are generated and verified):\\n1. STITCH: composite ALL the generated kit pieces (world props, item icons, buttons, panels, bars) together into a SINGLE image — use image stitching/compositing to arrange them on one sheet in tidy groups (a props row, an icon grid, the button states, the panels/bars) at consistent scale and spacing.\\n2. POLISH (image EDIT pass): run an image edit ON that stitched composite so it reads as a finished presentation sheet — even spacing and alignment, one cohesive background, unified lighting and color grade across every piece, consistent padding and gentle grounding — WITHOUT changing any asset's identity, style, palette, or geometry (do NOT restyle, redraw, add, or remove assets; only clean up layout, background, and overall polish). Lead the edit prompt with the chosen art-style words so the polish stays on-style.\\n3. DELIVER this final combined, polished kit sheet as the HERO result of the run, IN ADDITION to the individual engine-ready assets (the transparent cutouts and whole UI pieces are still delivered; the combined sheet is the showcase of the cohesive kit).\\n\\n=== USER INPUT ===\\nStyle: {{style}}\\nKit contents: {{contents}}\\nItems: {{description}}\",\"variants\":[{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/props_ui_kit/variants/PUK-49-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/props_ui_kit/variants/PUK-07-output.jpg?v=20260723\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/props_ui_kit/variants/PUK-16-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/props_ui_kit/variants/PUK-02-output.jpg?v=20260723\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/props_ui_kit/variants/PUK-12-output.jpg\"},{\"inputs\":null,\"output\":\"https://imagine-public.x.ai/agent-skills/props_ui_kit/variants/PUK-47-output.jpg?v=20260723\"}]}],\"enable_imagine_discover_v2\":true,\"grok_web_shared_workspace_preview\":true,\"enable_inline_auto_topup_disable\":true,\"enable_topup_update_delay_copy\":true,\"enable_automations_weekday_cadence\":false,\"enable_grok_4_5_copy\":true,\"grok_subscription_copy_version\":\"4.5\",\"imagine_agent_connectors_global_persistence\":true,\"credit-topup-config\":{\"default\":[5,20,50,100]},\"grok_chat_external_project_computer_root_enabled_web\":true,\"enable_imagine_api_v2\":true,\"imagine-edits\":{},\"show_x_connector_ready_banner\":false,\"enable_prepaid_benefits\":true,\"enable_downgrade_cards_paywall\":true,\"supergrok_paywall_heavy_x_premium_plus_enabled\":true,\"enable_usage_limit_reset\":true,\"hide_project_conversations_from_history_web\":false,\"connectors_rest_proxy_enabled\":true,\"imagine_agent_draft_streaming\":true,\"grok_chat_external_project_computer_root_providers_web\":{\"google_drive\":true,\"box\":true,\"one_drive\":true,\"share_point\":true},\"enable_usage_limit_reset_banner\":true,\"grok_web_team_management\":true,\"app_builder_custom_domains\":false,\"imagine_skill_query_bar\":{},\"app_builder_app_list_enabled\":false,\"show_open_in_app_on_ios_safari\":true,\"grok_web_imagine_enabled\":true,\"grok_web_can_access_imagine\":true,\"grok_web_can_access_imagine_tab\":true,\"grok_web_can_access_imagine_chat\":true,\"grok_web_can_access_imagine_nsfw\":true,\"grok_web_can_access_usage\":true,\"grok_web_team_url_blocklist_enabled\":false,\"grok_web_onboarding_prompts_settings_tab\":true,\"projects