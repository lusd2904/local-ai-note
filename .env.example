# ------------------------------------------------------------------------------
# 本地 AI 智能笔记系统环境变量配置示例 (.env.example)
# ------------------------------------------------------------------------------

# 前端 Web 访问端口 (默认 3000)
PORT=3000

# 后端 API 端口 (默认 8008)
BACKEND_PORT=8008

# AI 默认配置 (可选，应用内支持在设置面板动态配置与多渠道自由切换)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.anthropic.com/v1
AI_MODEL=claude-3-7-sonnet-20250219
